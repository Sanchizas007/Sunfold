    "onboarding.health.acknowledge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read this and understand that Sunfold does not give medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прочитав це й розумію, що Sunfold не дає медичних порад."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прочитал это и понимаю, что Sunfold не даёт медицинских советов."
          }
        }
      }
    },
    "onboarding.health.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
