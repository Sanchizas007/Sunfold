    "history.chart.locked.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how your fasting hours add up over time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie sich deine Fastenstunden mit der Zeit summieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez vos heures de jeûne s’accumuler au fil du temps."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cómo se suman tus horas de ayuno con el tiempo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba cómo se suman tus horas de ayuno con el tiempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja como suas horas de jejum se somam ao longo do tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda come si sommano le tue ore di digiuno nel tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie hoe je vastenuren zich in de loop van de tijd optellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, jak twoje godziny postu sumują się w czasie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファスティングの時間が積み重なっていく様子を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 시간이 어떻게 쌓여 가는지 확인해 보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите, как накапливаются ваши часы голодания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дивіться, як накопичуються ваші години голодування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你的断食时长如何随时间累积。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你的斷食時數如何隨時間累積。"
          }
        }
      }
    },
