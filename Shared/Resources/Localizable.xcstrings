          }
        }
      }
    },
    "disclaimer.stop.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizziness, faintness, confusion, a racing heart or unusual weakness are reasons to eat and to seek medical help. No streak is worth it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwindel, Ohnmachtsgefühl, Verwirrtheit, Herzrasen oder ungewöhnliche Schwäche sind Gründe, zu essen und ärztliche Hilfe zu suchen. Keine Serie ist das wert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertiges, malaise, confusion, cœur qui s’emballe ou faiblesse inhabituelle sont des raisons de manger et de consulter. Aucune série ne vaut cela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Головокружение, слабость, спутанность сознания, учащённое сердцебиение или необычная вялость — повод поесть и обратиться за медицинской помощью. Никакая серия этого не стоит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запаморочення, слабкість, сплутаність свідомості, прискорене серцебиття чи незвична млявість — привід поїсти та звернутися по медичну допомогу. Жодна серія цього не варта."
          }
        }
      }
    },
    "disclaimer.stop.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop if you feel unwell"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör auf, wenn du dich unwohl fühlst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez si vous vous sentez mal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановитесь, если плохо"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніться, якщо погано"
          }
        }
      }
    },
