        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des rappels à la fin de votre jeûne — vous décidez de les autoriser ou non."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos cuando termine tu ayuno: tú decides si los permites."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos cuando termine tu ayuno: tú decides si los permites."
          }
        },
        "pt-BR": {
