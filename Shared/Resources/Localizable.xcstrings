    "onboarding.health.acknowledge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read this and understand that Sunfold does not give medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe das gelesen und verstanden, dass Sunfold keine medizinische Beratung gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai lu ceci et je comprends que Sunfold ne donne pas d’avis médical."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "He leído esto y entiendo que Sunfold no da consejo médico."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "He leído esto y entiendo que Sunfold no da consejo médico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Li isto e entendo que o Sunfold não dá orientação médica."
          }
        },
        "it": {
          "stringUnit": {
