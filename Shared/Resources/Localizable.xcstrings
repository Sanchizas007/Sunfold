    "phase.autophagy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most of what is known comes from animal studies. Human research is still limited, and there is no way to measure it from a phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das meiste Wissen stammt aus Tierstudien. Die Forschung am Menschen ist noch begrenzt, und vom Telefon aus lässt sich das nicht messen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essentiel de ce que l’on sait vient d’études animales. La recherche chez l’humain reste limitée, et rien ne permet de le mesurer depuis un téléphone."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todo lo que se sabe viene de estudios en animales. La investigación en humanos todavía es limitada, y no hay forma de medirlo desde un teléfono."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todo lo que se sabe viene de estudios en animales. La investigación en humanos todavía es limitada, y no hay forma de medirlo desde un móvil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase tudo o que se sabe vem de estudos em animais. A pesquisa em humanos ainda é limitada, e não há como medir isso pelo celular."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi tutto quello che si sa viene da studi sugli animali. La ricerca sull’uomo è ancora limitata, e non c’è modo di misurarla da un telefono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het meeste van wat bekend is komt uit dierstudies. Onderzoek bij mensen is nog beperkt, en vanaf een telefoon is het niet te meten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większość tego, co wiadomo, pochodzi z badań na zwierzętach. Badania u ludzi są wciąż ograniczone, a z poziomu telefonu nie da się tego zmierzyć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかっていることの多くは動物実験によるものです。人での研究はまだ限られており、スマートフォンから測ることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려진 내용의 대부분은 동물 연구에서 나왔습니다. 사람을 대상으로 한 연구는 아직 제한적이고, 휴대폰으로 측정할 방법도 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большая часть известного получена в исследованиях на животных. Исследований на людях пока мало, а измерить это с телефона невозможно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більшість відомого походить із досліджень на тваринах. Досліджень на людях поки мало, а виміряти це з телефона неможливо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前所知的大多来自动物研究。人体研究仍然有限，而且也没有办法用手机测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前所知的大多來自動物研究。人體研究仍然有限，而且也沒有辦法用手機測量。"
          }
        }
      }
    },
    "phase.autophagy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellular recycling is thought to increase during longer fasts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Man nimmt an, dass die Zellerneuerung bei längerem Fasten zunimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On pense que le recyclage cellulaire augmente lors des jeûnes longs."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cree que el reciclaje celular aumenta durante los ayunos largos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cree que el reciclaje celular aumenta durante los ayunos largos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acredita-se que a reciclagem celular aumente durante jejuns mais longos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ritiene che il riciclo cellulare aumenti durante i digiuni più lunghi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Men denkt dat de celvernieuwing toeneemt tijdens langere vastenperiodes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uważa się, że podczas dłuższych postów nasila się odnowa komórek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いファスティング中は細胞のリサイクルが活発になると考えられています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 단식 동안 세포 재생이 늘어나는 것으로 여겨집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считается, что во время долгих голоданий усиливается клеточное самообновление."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вважається, що під час довших голодувань посилюється клітинне самооновлення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一般认为，在较长的断食中细胞自我回收会增强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般認為，在較長的斷食中細胞自我回收會增強。"
          }
        }
      }
    },
