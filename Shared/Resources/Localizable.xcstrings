    "disclaimer.askFirst.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please speak to a healthcare professional before fasting if you are pregnant or breastfeeding, under 18, living with diabetes or taking medication that affects blood sugar, taking any medicine that must be taken with food, underweight, or living with a chronic condition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte sprich vor dem Fasten mit einer Ärztin oder einem Arzt, wenn du schwanger bist oder stillst, unter 18 bist, mit Diabetes lebst oder Medikamente nimmst, die den Blutzucker beeinflussen, Medikamente einnimmst, die zu einer Mahlzeit gehören, untergewichtig bist oder eine chronische Erkrankung hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez-en à un professionnel de santé avant de jeûner si vous êtes enceinte ou allaitez, avez moins de 18 ans, vivez avec un diabète ou prenez un traitement qui agit sur la glycémie, prenez un médicament à prendre au cours d’un repas, êtes en insuffisance pondérale ou vivez avec une maladie chronique."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con un profesional de la salud antes de ayunar si estás embarazada o amamantando, eres menor de 18 años, vives con diabetes o tomas medicamentos que afectan el azúcar en sangre, tomas algún medicamento que debe tomarse con alimentos, tienes bajo peso o vives con una enfermedad crónica."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con un profesional sanitario antes de ayunar si estás embarazada o dando el pecho, eres menor de 18 años, convives con diabetes o tomas medicación que afecta al azúcar en sangre, tomas algún medicamento que debe tomarse con comida, tienes bajo peso o convives con una enfermedad crónica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converse com um profissional de saúde antes de jejuar se você estiver grávida ou amamentando, tiver menos de 18 anos, viver com diabetes ou tomar medicamentos que afetam o açúcar no sangue, tomar algum remédio que precisa ser tomado com comida, estiver abaixo do peso ou viver com uma condição crônica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратитесь к врачу перед голоданием, если вы беременны или кормите грудью, вам меньше 18 лет, у вас диабет или вы принимаете лекарства, влияющие на уровень сахара, принимаете любые лекарства, которые надо пить с едой, имеете недостаточный вес или хроническое заболевание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверніться до лікаря перед голодуванням, якщо ви вагітні чи годуєте груддю, вам менше 18 років, у вас діабет або ви приймаєте ліки, що впливають на рівень цукру, приймаєте будь-які ліки, які треба пити з їжею, маєте недостатню вагу чи хронічне захворювання."
          }
        }
      }
    },
    "disclaimer.askFirst.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to a doctor first"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich zuerst mit einer Ärztin oder einem Arzt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez-en d’abord à un médecin"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla primero con tu médico"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla antes con tu médico"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale primeiro com um médico"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала посоветуйтесь с врачом"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу порадьтеся з лікарем"
          }
        }
      }
    },
    "disclaimer.eatingDisorders.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have or have had an eating disorder, or if tracking meals makes you anxious, a fasting app can make things worse. Please talk to a doctor or a support service where you live before using Sunfold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Essstörung hast oder hattest oder wenn dich das Erfassen von Mahlzeiten beunruhigt, kann eine Fasten-App alles schwieriger machen. Bitte sprich mit einer Ärztin, einem Arzt oder einer Beratungsstelle in deiner Nähe, bevor du Sunfold nutzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez ou avez eu un trouble du comportement alimentaire, ou si le suivi des repas vous angoisse, une application de jeûne peut aggraver les choses. Parlez-en à un médecin ou à un service d’accompagnement près de chez vous avant d’utiliser Sunfold."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes o has tenido un trastorno alimentario, o si llevar un registro de las comidas te genera ansiedad, una app de ayuno puede empeorar las cosas. Habla con tu médico o con un servicio de apoyo en tu zona antes de usar Sunfold."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes o has tenido un trastorno de la conducta alimentaria, o si llevar un registro de las comidas te genera ansiedad, una app de ayuno puede empeorar las cosas. Habla con tu médico o con un servicio de apoyo de tu zona antes de usar Sunfold."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você tem ou já teve um transtorno alimentar, ou se registrar refeições te deixa ansioso, um app de jejum pode piorar as coisas. Converse com um médico ou com um serviço de apoio da sua região antes de usar o Sunfold."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у вас есть или было расстройство пищевого поведения, или если отслеживание еды вызывает тревогу, приложение для голодания может ухудшить состояние. Сначала поговорите с врачом или службой поддержки в вашей стране."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо у вас є або був розлад харчової поведінки, або якщо відстеження їжі викликає тривогу, застосунок для голодування може погіршити стан. Спершу поговоріть із лікарем або службою підтримки у вашій країні."
          }
        }
      }
    },
    "disclaimer.eatingDisorders.title": {
