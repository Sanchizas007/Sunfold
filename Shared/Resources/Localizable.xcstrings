    "privacy.children.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold is not directed at children and is not intended for anyone under 18 without medical supervision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold richtet sich nicht an Kinder und ist ohne ärztliche Begleitung nicht für Personen unter 18 Jahren gedacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold ne s’adresse pas aux enfants et n’est pas destiné aux personnes de moins de 18 ans sans suivi médical."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold no está dirigida a menores y no está pensada para personas menores de 18 años sin supervisión médica."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold no está dirigida a menores y no está pensada para personas menores de 18 años sin supervisión médica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunfold não é voltado a crianças e não é destinado a menores de 18 anos sem acompanhamento médico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold не предназначена для детей и не рекомендована лицам до 18 лет без наблюдения врача."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold не призначена для дітей і не рекомендована особам до 18 років без нагляду лікаря."
          }
        }
      }
    },
