    "privacy.lede": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold has no account, no server and no analytics. Everything you record lives on your device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Sunfold немає акаунта, сервера й аналітики. Усе, що ви записуєте, живе на вашому пристрої."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Sunfold нет аккаунта, сервера и аналитики. Всё, что вы записываете, живёт на вашем устройстве."
          }
        }
      }
    },
    "privacy.notCollected.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no email address, no advertising identifiers, no analytics or tracking SDKs, no location. Nothing you record is sent anywhere, because Sunfold has no server to send it to."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні акаунта, ні електронної пошти, ні рекламних ідентифікаторів, ні аналітики чи трекінгових SDK, ні геолокації. Нічого із записаного вами нікуди не надсилається, бо в Sunfold просто немає сервера."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни аккаунта, ни электронной почты, ни рекламных идентификаторов, ни аналитики или трекинговых SDK, ни геолокации. Ничего из записанного вами никуда не отправляется, потому что у Sunfold просто нет сервера."
          }
        }
      }
    },
    "privacy.notCollected.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Sunfold does not collect"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чого Sunfold не збирає"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чего Sunfold не собирает"
          }
        }
      }
    },
    "privacy.notifications.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All reminders are scheduled locally by your iPhone. Sunfold has no push server, and notification content never leaves your device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі нагадування планує локально ваш iPhone. У Sunfold немає push-сервера, і вміст сповіщень ніколи не залишає ваш пристрій."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все напоминания планирует локально ваш iPhone. У Sunfold нет push-сервера, и содержимое уведомлений никогда не покидает ваше устройство."
          }
        }
      }
    },
    "privacy.notifications.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления"
          }
        }
      }
    },
    "privacy.purchases.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases are processed by Apple. To check whether Sunfold Pro is active, the app uses RevenueCat, which receives a randomly generated app user ID and your App Store receipt. It never receives your name, your email, or anything you record in Sunfold."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки обробляє Apple. Щоб перевірити, чи активний Sunfold Pro, застосунок використовує RevenueCat, який отримує випадково згенерований ідентифікатор користувача та ваш чек App Store. Він ніколи не отримує ваше ім'я, пошту чи будь-що записане в Sunfold."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки обрабатывает Apple. Чтобы проверить, активен ли Sunfold Pro, приложение использует RevenueCat, который получает случайно сгенерированный идентификатор пользователя и ваш чек App Store. Он никогда не получает ваше имя, почту или что-либо записанное в Sunfold."
          }
        }
      }
    },
    "privacy.purchases.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки"
          }
        }
      }
    },
    "privacy.stored.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fasts, weight entries, notes and settings are saved on this device. If you have iPhone backups switched on, they are included in your own backup, which only you can open."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші голодування, записи ваги, нотатки й налаштування зберігаються на цьому пристрої. Якщо у вас увімкнено резервні копії iPhone, вони потрапляють до вашої власної копії, яку можете відкрити лише ви."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши голодания, записи веса, заметки и настройки хранятся на этом устройстве. Если у вас включены резервные копии iPhone, они попадают в вашу собственную копию, которую можете открыть только вы."
          }
        }
      }
    },
    "privacy.stored.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Sunfold stores"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що зберігає Sunfold"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
