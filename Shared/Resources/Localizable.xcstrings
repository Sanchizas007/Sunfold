        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно сохранится в истории с тем временем, которое вы уже проголодали."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його буде збережено в історії з тим часом, який ви вже проголодували."
