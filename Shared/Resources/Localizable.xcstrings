    "phase.autophagy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most of what is known comes from animal studies. Human research is still limited, and there is no way to measure it from a phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das meiste Wissen stammt aus Tierstudien. Die Forschung am Menschen ist noch begrenzt, und vom Telefon aus lässt sich das nicht messen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essentiel de ce que l’on sait vient d’études animales. La recherche chez l’humain reste limitée, et rien ne permet de le mesurer depuis un téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большая часть известного получена в исследованиях на животных. Исследований на людях пока мало, а измерить это с телефона невозможно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більшість відомого походить із досліджень на тваринах. Досліджень на людях поки мало, а виміряти це з телефона неможливо."
          }
        }
      }
    },
    "phase.autophagy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellular recycling is thought to increase during longer fasts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Man nimmt an, dass die Zellerneuerung bei längerem Fasten zunimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On pense que le recyclage cellulaire augmente lors des jeûnes longs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считается, что во время долгих голоданий усиливается клеточное самообновление."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вважається, що під час довших голодувань посилюється клітинне самооновлення."
          }
        }
      }
    },
    "phase.autophagy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autophagy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autophagie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autophagie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутофагия"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутофагія"
          }
        }
      }
    },
    "phase.early.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glycogen — glucose stored in the liver and muscles — usually covers energy needs through this window."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glykogen — in Leber und Muskeln gespeicherte Glukose — deckt den Energiebedarf in diesem Zeitraum meist ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le glycogène — le glucose stocké dans le foie et les muscles — couvre généralement les besoins en énergie sur cette période."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гликоген — глюкоза, запасённая в печени и мышцах, — обычно покрывает потребность в энергии в этом промежутке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Глікоген — глюкоза, запасена в печінці та м'язах, — зазвичай покриває потребу в енергії протягом цього проміжку."
          }
        }
      }
    },
    "phase.early.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insulin falls and the liver begins releasing stored glucose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Insulin sinkt, und die Leber gibt gespeicherte Glukose ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’insuline baisse et le foie commence à libérer le glucose stocké."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсулин снижается, и печень начинает отдавать запасы глюкозы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсулін знижується, і печінка починає віддавати запаси глюкози."
          }
        }
      }
    },
    "phase.early.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Early fasting"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühes Fasten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Début du jeûne"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раннее голодание"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раннє голодування"
          }
        }
      }
    },
    "phase.fat.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shift is gradual rather than a switch, and how quickly it happens varies a great deal between people."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel ist allmählich und kein Schalter, und wie schnell er geschieht, ist von Mensch zu Mensch sehr verschieden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passage est progressif plutôt qu’un basculement, et sa rapidité varie beaucoup d’une personne à l’autre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход постепенный, а не мгновенный, и его скорость сильно различается у разных людей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перехід поступовий, а не миттєвий, і його швидкість дуже різна в різних людей."
          }
        }
      }
    },
    "phase.fat.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glycogen runs low and the body turns more towards fat for fuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Glykogen wird knapp, und der Körper nutzt stärker Fett als Brennstoff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le glycogène s’épuise et le corps se tourne davantage vers les graisses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гликогена становится меньше, и организм всё больше переходит на жир как топливо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Глікогену стає менше, і організм дедалі більше переходить на жир як паливо."
          }
        }
      }
    },
    "phase.fat.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat burning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fettverbrennung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combustion des graisses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжигание жира"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спалювання жиру"
          }
        }
      }
    },
    "phase.fed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood sugar and insulin typically rise after eating, and energy comes from the meal rather than from stores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutzucker und Insulin steigen nach dem Essen üblicherweise an, und die Energie kommt aus der Mahlzeit statt aus den Speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La glycémie et l’insuline montent généralement après le repas, et l’énergie vient du repas plutôt que des réserves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После еды сахар в крови и инсулин обычно растут, и энергия берётся из пищи, а не из запасов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після їжі цукор у крові й інсулін зазвичай зростають, і енергія береться з їжі, а не із запасів."
          }
        }
      }
    },
    "phase.fed.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body is digesting the last meal and running on it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Körper verdaut die letzte Mahlzeit und lebt von ihr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps digère le dernier repas et fonctionne avec."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Организм переваривает последний приём пищи и живёт на нём."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Організм перетравлює останній прийом їжі й живиться ним."
          }
        }
      }
    },
    "phase.fed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fed state"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesättigter Zustand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État postprandial"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сытое состояние"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ситий стан"
          }
        }
      }
    },
    "phase.ketosis.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some people report steadier energy and less hunger here; others notice nothing in particular. Both are normal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche berichten hier von gleichmäßigerer Energie und weniger Hunger, andere bemerken nichts Besonderes. Beides ist normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines personnes rapportent ici une énergie plus stable et moins de faim ; d’autres ne remarquent rien de particulier. Les deux sont normaux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то отмечает более ровную энергию и меньший голод, кто-то не замечает ничего особенного. Оба варианта нормальны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дехто відзначає рівнішу енергію та менший голод, дехто не помічає нічого особливого. Обидва варіанти нормальні."
          }
        }
      }
    },
    "phase.ketosis.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The liver produces ketones from fat, which the brain can use as fuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leber bildet aus Fett Ketone, die das Gehirn als Brennstoff nutzen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foie produit des cétones à partir des graisses, que le cerveau peut utiliser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печень вырабатывает кетоны из жира, и мозг может использовать их как топливо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Печінка виробляє кетони з жиру, і мозок може використовувати їх як паливо."
          }
        }
      }
    },
    "phase.ketosis.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketosis"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketose"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cétose"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кетоз"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кетоз"
          }
        }
      }
    },
    "phases.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These hours are approximations drawn from general research. What actually happens depends on your last meal, your activity and your body. This is educational information, not medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Stunden sind Näherungswerte aus allgemeiner Forschung. Was tatsächlich passiert, hängt von deiner letzten Mahlzeit, deiner Bewegung und deinem Körper ab. Das sind Informationen zur Aufklärung, keine medizinische Beratung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces heures sont des approximations issues de la recherche générale. Ce qui se passe réellement dépend de votre dernier repas, de votre activité et de votre corps. Il s’agit d’information générale, pas d’un avis médical."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти часы — приблизительные ориентиры из общих исследований. Что происходит на самом деле, зависит от последнего приёма пищи, активности и вашего организма. Это образовательная информация, а не медицинский совет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці години — приблизні орієнтири із загальних досліджень. Що відбувається насправді, залежить від останнього прийому їжі, активності та вашого організму. Це освітня інформація, а не медична порада."
          }
        }
      }
    },
