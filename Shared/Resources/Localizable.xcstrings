        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vasten bereikt het doel over een half uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój post osiągnie cel za pół godziny."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと30分で目標に到達します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше голодание достигнет цели через полчаса."
