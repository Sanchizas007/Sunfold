    "protocol.custom.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything from 4 to 48 hours, in half-hour steps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles von 4 bis 48 Stunden, in halben Stunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De 4 à 48 heures, par pas d’une demi-heure."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "De 4 a 48 horas, en pasos de media hora."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "De 4 a 48 horas, en pasos de media hora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 4 a 48 horas, em passos de meia hora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 4 a 48 ore, a passi di mezz’ora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles van 4 tot 48 uur, in stappen van een half uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od 4 do 48 godzin, co pół godziny."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4〜48時間のあいだで、30分きざみに設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4시간에서 48시간까지, 30분 단위로."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 4 до 48 часов, с шагом в полчаса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від 4 до 48 годин, з кроком у пів години."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4 到 48 小时之间，以半小时为步进。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4 到 48 小時之間，以半小時為單位。"
          }
        }
      }
    },
