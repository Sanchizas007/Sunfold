    "protocol.16_8.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The usual place to start — for most people that means a later breakfast or an earlier dinner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der übliche Anfang — für die meisten heißt das ein späteres Frühstück oder ein früheres Abendessen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de départ habituel — pour la plupart, un petit-déjeuner plus tard ou un dîner plus tôt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый распространённый старт — обычно это поздний завтрак или ранний ужин."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найпоширеніший старт — зазвичай це пізніший сніданок або ранішня вечеря."
          }
        }
      }
    },
