    "protocol.custom.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything from 4 to 48 hours, in half-hour steps."
          }
        },
        "de": {
          "stringUnit": {
