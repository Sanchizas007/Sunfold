    "privacy.changes.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this policy changes, the updated version appears here and in the app itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich diese Richtlinie ändert, erscheint die aktualisierte Fassung hier und in der App selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette politique change, la version mise à jour apparaîtra ici et dans l’app elle-même."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esta política cambia, la versión actualizada aparecerá aquí y en la propia app."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esta política cambia, la versión actualizada aparecerá aquí y en la propia app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esta política mudar, a versão atualizada aparece aqui e no próprio app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se questa informativa cambia, la versione aggiornata compare qui e nell’app stessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit beleid verandert, verschijnt de bijgewerkte versie hier en in de app zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ta polityka się zmieni, zaktualizowana wersja pojawi się tutaj i w samej aplikacji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このポリシーが変わった場合、更新版はこことアプリ内に掲載されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정책이 바뀌면 갱신된 내용이 여기와 앱 안에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если политика изменится, обновлённая версия появится здесь и в самом приложении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо політика зміниться, оновлена версія з'явиться тут і в самому застосунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果本政策有变化，更新后的版本会出现在这里以及 App 内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果本政策有變動，更新後的版本會出現在這裡以及 App 內。"
          }
        }
      }
    },
