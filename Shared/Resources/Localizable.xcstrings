    "privacy.purchases.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases are processed by Apple. To check whether Sunfold Pro is active, the app uses RevenueCat, which receives a randomly generated app user ID and your App Store receipt. It never receives your name, your email, or anything you record in Sunfold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe werden von Apple abgewickelt. Um zu prüfen, ob Sunfold Pro aktiv ist, nutzt die App RevenueCat, das eine zufällig erzeugte App-Nutzer-ID und deinen App-Store-Beleg erhält. Es erhält nie deinen Namen, deine E-Mail-Adresse oder etwas, das du in Sunfold erfasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats sont traités par Apple. Pour vérifier si Sunfold Pro est actif, l’app utilise RevenueCat, qui reçoit un identifiant d’utilisateur généré aléatoirement et votre reçu App Store. Il ne reçoit jamais votre nom, votre e-mail, ni rien de ce que vous enregistrez dans Sunfold."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras las procesa Apple. Para comprobar si Sunfold Pro está activo, la app usa RevenueCat, que recibe un ID de usuario generado al azar y tu recibo del App Store. Nunca recibe tu nombre, tu correo ni nada de lo que registras en Sunfold."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras las procesa Apple. Para comprobar si Sunfold Pro está activo, la app usa RevenueCat, que recibe un ID de usuario generado al azar y tu recibo del App Store. Nunca recibe tu nombre, tu correo ni nada de lo que registras en Sunfold."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras são processadas pela Apple. Para verificar se o Sunfold Pro está ativo, o app usa o RevenueCat, que recebe um ID de usuário gerado aleatoriamente e o seu recibo da App Store. Ele nunca recebe seu nome, seu e-mail nem nada do que você registra no Sunfold."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti sono gestiti da Apple. Per verificare se Sunfold Pro è attivo, l’app usa RevenueCat, che riceve un ID utente generato a caso e la tua ricevuta App Store. Non riceve mai il tuo nome, la tua e-mail né nulla di ciò che registri in Sunfold."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen worden door Apple afgehandeld. Om te controleren of Sunfold Pro actief is, gebruikt de app RevenueCat, dat een willekeurig gegenereerde gebruikers-ID en je App Store-bon ontvangt. Het ontvangt nooit je naam, je e-mailadres of iets van wat je in Sunfold vastlegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy obsługuje Apple. Aby sprawdzić, czy Sunfold Pro jest aktywny, aplikacja korzysta z RevenueCat, który otrzymuje losowo wygenerowany identyfikator użytkownika i twoje potwierdzenie z App Store. Nigdy nie dostaje twojego imienia, adresu e-mail ani niczego, co zapisujesz w Sunfold."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入はAppleが処理します。Sunfold Proが有効かどうかを確認するため、アプリはRevenueCatを利用します。RevenueCatが受け取るのは、ランダムに生成された利用者IDとApp Storeのレシートだけです。あなたの名前やメールアドレス、Sunfoldに記録した内容を受け取ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입은 Apple이 처리합니다. Sunfold Pro가 활성 상태인지 확인하기 위해 앱은 RevenueCat을 사용하며, RevenueCat은 무작위로 만들어진 사용자 ID와 App Store 영수증만 받습니다. 이름이나 이메일, Sunfold에 기록한 내용은 전혀 받지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки обрабатывает Apple. Чтобы проверить, активен ли Sunfold Pro, приложение использует RevenueCat, который получает случайно сгенерированный идентификатор пользователя и ваш чек App Store. Он никогда не получает ваше имя, почту или что-либо записанное в Sunfold."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки обробляє Apple. Щоб перевірити, чи активний Sunfold Pro, застосунок використовує RevenueCat, який отримує випадково згенерований ідентифікатор користувача та ваш чек App Store. Він ніколи не отримує ваше ім'я, пошту чи будь-що записане в Sunfold."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买由 Apple 处理。为了确认 Sunfold Pro 是否有效，App 使用 RevenueCat，它收到的只是一个随机生成的用户 ID 和你的 App Store 收据。它永远不会收到你的姓名、电子邮件，或你在 Sunfold 中记录的任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買由 Apple 處理。為了確認 Sunfold Pro 是否有效，App 使用 RevenueCat，它收到的只是一組隨機產生的使用者 ID 和你的 App Store 收據。它永遠不會收到你的姓名、電子郵件，或你在 Sunfold 中記錄的任何內容。"
          }
        }
      }
    },
