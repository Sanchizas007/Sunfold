            "value": "If this policy changes, the updated version appears here and in the app itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich diese Richtlinie ändert, erscheint die aktualisierte Fassung hier und in der App selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette politique change, la version mise à jour apparaîtra ici et dans l’app elle-même."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если политика изменится, обновлённая версия появится здесь и в самом приложении."
          }
        },
        "uk": {
