    "settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold keeps everything on your device. No account, no server, no tracking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold behält alles auf deinem Gerät. Kein Account, kein Server, kein Tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold garde tout sur votre appareil. Pas de compte, pas de serveur, pas de pistage."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold guarda todo en tu dispositivo. Sin cuenta, sin servidor, sin rastreo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold lo guarda todo en tu dispositivo. Sin cuenta, sin servidor, sin rastreo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunfold guarda tudo no seu dispositivo. Sem conta, sem servidor, sem rastreamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold tiene tutto sul tuo dispositivo. Nessun account, nessun server, nessun tracciamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold houdt alles op je apparaat. Geen account, geen server, geen tracking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold trzyma wszystko na twoim urządzeniu. Bez konta, bez serwera, bez śledzenia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfoldはすべてを端末の中に保ちます。アカウントなし、サーバーなし、トラッキングなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold는 모든 것을 기기 안에 둡니다. 계정 없음, 서버 없음, 추적 없음."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold хранит всё на вашем устройстве. Без аккаунта, без сервера, без слежки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold зберігає все на вашому пристрої. Без акаунта, без сервера, без стеження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 把一切都留在你的设备上。没有账户，没有服务器，没有追踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 把一切都留在你的裝置上。沒有帳號，沒有伺服器，沒有追蹤。"
          }
        }
      }
    },
