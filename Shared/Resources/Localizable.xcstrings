    "protocol.20_4.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One long fast and a short window. Demanding — worth easing into."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein langes Fasten und ein kurzes Fenster. Fordernd — taste dich heran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un long jeûne et une fenêtre courte. Exigeant — mieux vaut y aller progressivement."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ayuno largo y una ventana corta. Exigente: conviene llegar poco a poco."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ayuno largo y una ventana corta. Exigente: mejor llegar poco a poco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jejum longo e uma janela curta. Exigente — vale ir aos poucos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долгое голодание и короткое окно. Требовательный режим — заходите постепенно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довге голодування й коротке вікно. Вимогливий режим — заходьте поступово."
          }
        }
      }
    },
