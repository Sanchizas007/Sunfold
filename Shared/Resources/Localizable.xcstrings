    "protocol.18_6.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A step up from 16:8, once that has become routine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stufe über 16:8, sobald das zur Routine geworden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cran au-dessus du 16:8, une fois qu’il est devenu une habitude."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso más que el 16:8, cuando ya se volvió rutina."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso más que el 16:8, cuando ya se ha vuelto rutina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um passo além do 16:8, quando ele já virou rotina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gradino sopra il 16:8, una volta che è diventato abitudine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stap verder dan 16:8, zodra dat routine is geworden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krok dalej niż 16:8, kiedy to już weszło w rutynę."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "16:8が習慣になったら、その一歩先へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "16:8이 몸에 익은 다음의 한 단계."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий шаг после 16:8, когда тот вошёл в привычку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступний крок після 16:8, коли той увійшов у звичку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等 16:8 成了习惯，再往前一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等 16:8 成了習慣，再往前一步。"
          }
        }
      }
    },
