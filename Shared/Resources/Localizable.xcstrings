    "notification.complete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached your goal. Open Sunfold to end the fast whenever you are ready."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Ziel erreicht. Öffne Sunfold und beende das Fasten, wann immer du so weit bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint votre objectif. Ouvrez Sunfold pour terminer le jeûne quand vous le souhaitez."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcanzaste tu meta. Abre Sunfold para terminar el ayuno cuando quieras."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado tu objetivo. Abre Sunfold para terminar el ayuno cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você alcançou sua meta. Abra o Sunfold para encerrar o jejum quando quiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il tuo obiettivo. Apri Sunfold e concludi il digiuno quando vuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je doel bereikt. Open Sunfold om het vasten te beëindigen wanneer je er klaar voor bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel osiągnięty. Otwórz Sunfold i zakończ post, kiedy będziesz gotowy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標に到達しました。Sunfoldを開いて、好きなタイミングで終了してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы достигли цели. Откройте Sunfold и завершите голодание, когда будете готовы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви досягли цілі. Відкрийте Sunfold й завершіть голодування, коли будете готові."
          }
        }
      }
    },
