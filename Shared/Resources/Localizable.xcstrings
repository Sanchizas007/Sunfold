    "disclaimer.askFirst.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please speak to a healthcare professional before fasting if you are pregnant or breastfeeding, under 18, living with diabetes or taking medication that affects blood sugar, taking any medicine that must be taken with food, underweight, or living with a chronic condition."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратитесь к врачу перед голоданием, если вы беременны или кормите грудью, вам меньше 18 лет, у вас диабет или вы принимаете лекарства, влияющие на уровень сахара, принимаете любые лекарства, которые надо пить с едой, имеете недостаточный вес или хроническое заболевание."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зверніться до лікаря перед голодуванням, якщо ви вагітні чи годуєте груддю, вам менше 18 років, у вас діабет або ви приймаєте ліки, що впливають на рівень цукру, приймаєте будь-які ліки, які треба пити з їжею, маєте недостатню вагу чи хронічне захворювання."
          }
        }
      }
    },
    "disclaimer.askFirst.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talk to a doctor first"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала посоветуйтесь с врачом"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу порадьтеся з лікарем"
          }
        }
      }
    },
    "disclaimer.eatingDisorders.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have or have had an eating disorder, or if tracking meals makes you anxious, a fasting app can make things worse. Please talk to a doctor or a support service where you live before using Sunfold."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если у вас есть или было расстройство пищевого поведения, или если отслеживание еды вызывает тревогу, приложение для голодания может ухудшить состояние. Сначала поговорите с врачом или службой поддержки в вашей стране."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо у вас є або був розлад харчової поведінки, або якщо відстеження їжі викликає тривогу, застосунок для голодування може погіршити стан. Спершу поговоріть із лікарем або службою підтримки у вашій країні."
          }
        }
      }
    },
    "disclaimer.eatingDisorders.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If food is difficult"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если с едой сложно"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо з їжею складно"
          }
        }
      }
    },
    "disclaimer.heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunfold is a timer, not a doctor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunfold — это таймер, а не врач"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunfold — це таймер, а не лікар"
          }
        }
      }
    },
    "disclaimer.lede" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunfold tracks when you eat. It cannot know anything about your health, and it does not diagnose, treat or advise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunfold отслеживает, когда вы едите. Она ничего не знает о вашем здоровье и не диагностирует, не лечит и не советует."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunfold відстежує, коли ви їсте. Вона нічого не знає про ваше здоров'я й не діагностує, не лікує та не радить."
          }
        }
      }
    },
    "disclaimer.notMedical.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything in Sunfold, including the metabolic phases, is general educational information. It is not a diagnosis, a treatment plan, or a recommendation for you personally."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё в Sunfold, включая фазы метаболизма, — общая образовательная информация. Это не диагноз, не план лечения и не рекомендация лично для вас."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе в Sunfold, включно з фазами метаболізму, — загальна освітня інформація. Це не діагноз, не план лікування й не рекомендація особисто для вас."
          }
        }
      }
    },
    "disclaimer.notMedical.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not medical advice"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не медицинский совет"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це не медична порада"
          }
        }
      }
    },
    "disclaimer.phases.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hours shown for each metabolic phase are approximations from general research. What actually happens depends on your last meal, your activity, your sleep and your body. Treat them as a rough map, not a measurement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы для каждой фазы метаболизма — приблизительные ориентиры из общих исследований. Что происходит на самом деле, зависит от последнего приёма пищи, активности, сна и вашего организма. Воспринимайте это как приблизительную карту, а не измерение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Години для кожної фази метаболізму — приблизні орієнтири із загальних досліджень. Що відбувається насправді, залежить від останнього прийому їжі, активності, сну та вашого організму. Сприймайте це як приблизну карту, а не вимірювання."
          }
        }
      }
    },
    "disclaimer.phases.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About the phases"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "О фазах"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Про фази"
          }
        }
      }
    },
    "disclaimer.stop.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizziness, faintness, confusion, a racing heart or unusual weakness are reasons to eat and to seek medical help. No streak is worth it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Головокружение, слабость, спутанность сознания, учащённое сердцебиение или необычная вялость — повод поесть и обратиться за медицинской помощью. Никакая серия этого не стоит."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запаморочення, слабкість, сплутаність свідомості, прискорене серцебиття чи незвична млявість — привід поїсти та звернутися по медичну допомогу. Жодна серія цього не варта."
          }
        }
      }
    },
    "disclaimer.stop.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop if you feel unwell"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановитесь, если плохо"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупиніться, якщо погано"
          }
        }
      }
    },
    "disclaimer.title" : {
