    "protocol.16_8.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The usual place to start — for most people that means a later breakfast or an earlier dinner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der übliche Anfang — für die meisten heißt das ein späteres Frühstück oder ein früheres Abendessen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de départ habituel — pour la plupart, un petit-déjeuner plus tard ou un dîner plus tôt."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto de partida habitual: para la mayoría significa desayunar más tarde o cenar más temprano."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto de partida habitual: para la mayoría significa desayunar más tarde o cenar más pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ponto de partida de sempre — para a maioria, significa café da manhã mais tarde ou jantar mais cedo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punto di partenza abituale: per la maggior parte significa colazione più tardi o cena più presto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gebruikelijke start — voor de meesten betekent dat later ontbijten of eerder avondeten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykły punkt startu — dla większości oznacza późniejsze śniadanie albo wcześniejszą kolację."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん一般的な出発点。多くの人にとっては、朝食を遅らせるか夕食を早めることを意味します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый распространённый старт — обычно это поздний завтрак или ранний ужин."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найпоширеніший старт — зазвичай це пізніший сніданок або ранішня вечеря."
          }
        }
      }
    },
