    "disclaimer.stop.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizziness, faintness, confusion, a racing heart or unusual weakness are reasons to eat and to seek medical help. No streak is worth it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwindel, Ohnmachtsgefühl, Verwirrtheit, Herzrasen oder ungewöhnliche Schwäche sind Gründe, zu essen und ärztliche Hilfe zu suchen. Keine Serie ist das wert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertiges, malaise, confusion, cœur qui s’emballe ou faiblesse inhabituelle sont des raisons de manger et de consulter. Aucune série ne vaut cela."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mareo, desmayo, confusión, taquicardia o debilidad poco habitual son motivos para comer y buscar atención médica. Ninguna racha lo vale."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mareo, sensación de desmayo, confusión, taquicardia o debilidad poco habitual son motivos para comer y buscar atención médica. Ninguna racha lo vale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tontura, sensação de desmaio, confusão, coração acelerado ou fraqueza fora do comum são motivos para comer e procurar ajuda médica. Nenhuma sequência vale isso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capogiri, senso di svenimento, confusione, battito accelerato o debolezza insolita sono motivi per mangiare e cercare aiuto medico. Nessuna serie vale tanto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duizeligheid, flauwvallen, verwardheid, een razend hart of ongewone zwakte zijn redenen om te eten en medische hulp te zoeken. Geen enkele reeks is dat waard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawroty głowy, uczucie omdlenia, splątanie, kołatanie serca albo nietypowe osłabienie to powody, żeby zjeść i poszukać pomocy lekarskiej. Żadna seria nie jest tego warta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "めまい、立ちくらみ、意識のもうろう、動悸、いつもと違う強い脱力感は、食事をとって医療機関に相談すべきサインです。連続記録はそれに値しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Головокружение, слабость, спутанность сознания, учащённое сердцебиение или необычная вялость — повод поесть и обратиться за медицинской помощью. Никакая серия этого не стоит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запаморочення, слабкість, сплутаність свідомості, прискорене серцебиття чи незвична млявість — привід поїсти та звернутися по медичну допомогу. Жодна серія цього не варта."
          }
        }
      }
    },
    "disclaimer.stop.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop if you feel unwell"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör auf, wenn du dich unwohl fühlst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez si vous vous sentez mal"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Detente si te sientes mal"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para si te encuentras mal"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare se não se sentir bem"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermati se non ti senti bene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop als je je niet goed voelt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwij, jeśli źle się czujesz"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体調が悪いときは中止を"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановитесь, если плохо"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніться, якщо погано"
          }
        }
      }
