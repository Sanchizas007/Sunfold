    "timer.editStart.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved the start? Set the time you actually stopped eating. You can go back up to two days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start verschoben? Stelle die Zeit ein, zu der du wirklich aufgehört hast zu essen. Bis zu zwei Tage zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Début décalé ? Indiquez l’heure à laquelle vous avez vraiment arrêté de manger. Vous pouvez remonter jusqu’à deux jours."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Moviste el inicio? Pon la hora en que de verdad dejaste de comer. Puedes retroceder hasta dos días."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has movido el inicio? Pon la hora en la que de verdad dejaste de comer. Puedes retroceder hasta dos días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou o início? Coloque a hora em que você realmente parou de comer. Dá para voltar até dois dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai spostato l’inizio? Imposta l’ora in cui hai davvero smesso di mangiare. Puoi tornare indietro fino a due giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start verschoven? Zet de tijd waarop je echt gestopt bent met eten. Je kunt tot twee dagen terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesunąłeś start? Ustaw godzinę, o której naprawdę skończyłeś jeść. Możesz cofnąć się do dwóch dni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始がずれていましたか？実際に食べ終えた時刻を設定してください。2日前までさかのぼれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작이 달랐나요? 실제로 식사를 마친 시각을 넣으세요. 이틀 전까지 거슬러 갈 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыли запустить вовремя? Укажите, когда вы действительно перестали есть. Можно откатить до двух дней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забули запустити вчасно? Вкажіть, коли ви справді припинили їсти. Можна відкотити до двох днів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时间不对？填上你真正吃完的时刻。最多可以往回两天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時間不對？填上你真正吃完的時刻。最多可以往回兩天。"
          }
        }
      }
    },
