    "timer.idle.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start whenever you finish your last meal. Sunfold counts from that moment and tells you when your goal is reached."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte, wenn du deine letzte Mahlzeit beendet hast. Sunfold zählt ab diesem Moment und sagt dir, wann dein Ziel erreicht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez dès que vous finissez votre dernier repas. Sunfold compte à partir de ce moment et vous prévient quand l’objectif est atteint."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza cuando termines tu última comida. Sunfold cuenta desde ese momento y te avisa cuando alcances tu meta."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza cuando termines tu última comida. Sunfold cuenta desde ese momento y te avisa cuando alcances tu objetivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece quando terminar sua última refeição. O Sunfold conta a partir desse momento e avisa quando a meta for alcançada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте таймер после последнего приёма пищи. Sunfold считает с этого момента и сообщит, когда цель достигнута."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте таймер після останнього прийому їжі. Sunfold рахує від цієї миті й повідомить, коли ціль досягнуто."
          }
        }
      }
    },
