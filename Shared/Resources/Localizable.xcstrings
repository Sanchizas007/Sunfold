      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every schedule, your whole history, the charts and the metabolic phases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Rhythmus, dein ganzer Verlauf, die Diagramme und die Stoffwechselphasen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les rythmes, tout votre historique, les graphiques et les phases métaboliques."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los esquemas, tu historial completo, las gráficas y las fases metabólicas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las pautas, tu historial completo, los gráficos y las fases metabólicas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ritmos, seu histórico inteiro, os gráficos e as fases metabólicas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli schemi, la tua cronologia completa, i grafici e le fasi metaboliche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk schema, je hele geschiedenis, de grafieken en de stofwisselingsfasen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy plan, cała twoja historia, wykresy i fazy metaboliczne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのスケジュール、全履歴、グラフ、そして代謝フェーズ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 방식, 전체 기록, 차트, 그리고 대사 단계까지."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все графики, вся ваша история, диаграммы и фазы метаболизма."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі графіки, вся ваша історія, діаграми та фази метаболізму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部方案、完整历史、图表，以及代谢阶段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部方式、完整紀錄、圖表，以及代謝階段。"
          }
        }
      }
    },
    "paywall.subtitle.trial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have full access during your first week. Keep it when the week ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deiner ersten Woche hast du vollen Zugriff. Behalte ihn, wenn die Woche endet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez un accès complet pendant votre première semaine. Gardez-le à la fin de la semaine."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes acceso completo durante tu primera semana. Consérvalo cuando termine."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes acceso completo durante tu primera semana. Consérvalo cuando termine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem acesso completo durante a primeira semana. Continue com ele quando a semana acabar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai accesso completo durante la prima settimana. Tienilo quando la settimana finisce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt volledige toegang tijdens je eerste week. Houd die wanneer de week afloopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez pierwszy tydzień masz pełny dostęp. Zatrzymaj go, gdy tydzień się skończy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の1週間はすべて使えます。週が終わっても、そのまま使い続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 주 동안은 모두 사용할 수 있습니다. 주가 끝나도 그대로 이어 가세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В течение первой недели у вас полный доступ. Сохраните его, когда неделя закончится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Протягом першого тижня у вас повний доступ. Залиште його, коли тиждень мине."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一周你拥有全部权限。这一周结束后，也可以继续留着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一週你擁有全部功能。這一週結束後，也可以繼續留著。"
          }
        }
      }
    },
    "paywall.terms.lifetime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single payment with no renewal. Sunfold Pro stays with your Apple ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einmalige Zahlung ohne Verlängerung. Sunfold Pro bleibt bei deiner Apple-ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paiement unique, sans renouvellement. Sunfold Pro reste lié à votre identifiant Apple."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pago único sin renovación. Sunfold Pro queda ligado a tu ID de Apple."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pago único sin renovación. Sunfold Pro queda vinculado a tu ID de Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pagamento único, sem renovação. O Sunfold Pro fica com o seu ID Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pagamento unico senza rinnovo. Sunfold Pro resta legato al tuo ID Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén betaling zonder verlenging. Sunfold Pro blijft bij je Apple ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowa płatność bez odnawiania. Sunfold Pro zostaje przy twoim Apple ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新のない一度きりの支払いです。Sunfold ProはあなたのApple IDに紐づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 없는 일회 결제입니다. Sunfold Pro는 사용 중인 Apple 계정에 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один платёж без продления. Sunfold Pro остаётся на вашем Apple ID."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один платіж без поновлення. Sunfold Pro залишається на вашому Apple ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付款，不会续订。Sunfold Pro 会留在你的 Apple 账户下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付款，不會續訂。Sunfold Pro 會留在你的 Apple 帳號下。"
          }
        }
      }
    },
    "paywall.terms.subscription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple ID. The subscription renews automatically unless it is cancelled at least 24 hours before the period ends. Manage or cancel it any time in App Store settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird über deine Apple-ID abgerechnet. Das Abo verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ende des Zeitraums gekündigt wird. Du kannst es jederzeit in den App-Store-Einstellungen verwalten oder kündigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de votre identifiant Apple. L’abonnement se renouvelle automatiquement sauf résiliation au moins 24 heures avant la fin de la période. Vous pouvez le gérer ou le résilier à tout moment dans les réglages de l’App Store."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu ID de Apple. La suscripción se renueva automáticamente salvo que se cancele al menos 24 horas antes de que termine el periodo. Puedes administrarla o cancelarla cuando quieras en los ajustes del App Store."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu ID de Apple. La suscripción se renueva automáticamente salvo que se cancele al menos 24 horas antes de que termine el periodo. Puedes gestionarla o cancelarla cuando quieras en los ajustes del App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado no seu ID Apple. A assinatura renova automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período. Você pode gerenciar ou cancelar quando quiser nos ajustes da App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento viene addebitato sul tuo ID Apple. L’abbonamento si rinnova automaticamente se non viene annullato almeno 24 ore prima della fine del periodo. Puoi gestirlo o annullarlo quando vuoi nelle impostazioni dell’App Store."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling wordt in rekening gebracht op je Apple ID. Het abonnement wordt automatisch verlengd, tenzij het minstens 24 uur voor het einde van de periode wordt opgezegd. Je kunt het altijd beheren of opzeggen in de App Store-instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność jest pobierana z twojego Apple ID. Subskrypcja odnawia się automatycznie, o ile nie zostanie anulowana co najmniej 24 godziny przed końcem okresu. Możesz nią zarządzać lub anulować ją w dowolnej chwili w ustawieniach App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料金はあなたのApple IDに請求されます。期間終了の24時間前までに解約しない限り、自動的に更新されます。App Storeの設定からいつでも管理・解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 Apple 계정으로 청구됩니다. 기간이 끝나기 최소 24시간 전에 취소하지 않으면 구독이 자동으로 갱신됩니다. App Store 설정에서 언제든 관리하거나 취소할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списывается с вашего Apple ID. Подписка продлевается автоматически, если её не отменить минимум за 24 часа до конца периода. Управлять или отменить можно в любой момент в настройках App Store."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списується з вашого Apple ID. Підписка поновлюється автоматично, якщо її не скасувати щонайменше за 24 години до кінця періоду. Керувати чи скасувати можна будь-коли в налаштуваннях App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用将从你的 Apple 账户扣除。除非在当期结束前至少 24 小时取消，否则订阅会自动续订。你可以随时在 App Store 设置中管理或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "費用將從你的 Apple 帳號扣除。除非在當期結束前至少 24 小時取消，否則訂閱會自動續訂。你可以隨時在 App Store 設定中管理或取消。"
          }
        }
      }
    },
