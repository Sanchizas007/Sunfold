    "phase.autophagy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most of what is known comes from animal studies. Human research is still limited, and there is no way to measure it from a phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das meiste Wissen stammt aus Tierstudien. Die Forschung am Menschen ist noch begrenzt, und vom Telefon aus lässt sich das nicht messen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essentiel de ce que l’on sait vient d’études animales. La recherche chez l’humain reste limitée, et rien ne permet de le mesurer depuis un téléphone."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todo lo que se sabe viene de estudios en animales. La investigación en humanos todavía es limitada, y no hay forma de medirlo desde un teléfono."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todo lo que se sabe viene de estudios en animales. La investigación en humanos todavía es limitada, y no hay forma de medirlo desde un móvil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase tudo o que se sabe vem de estudos em animais. A pesquisa em humanos ainda é limitada, e não há como medir isso pelo celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большая часть известного получена в исследованиях на животных. Исследований на людях пока мало, а измерить это с телефона невозможно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більшість відомого походить із досліджень на тваринах. Досліджень на людях поки мало, а виміряти це з телефона неможливо."
          }
        }
      }
    },
    "phase.autophagy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellular recycling is thought to increase during longer fasts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Man nimmt an, dass die Zellerneuerung bei längerem Fasten zunimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On pense que le recyclage cellulaire augmente lors des jeûnes longs."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cree que el reciclaje celular aumenta durante los ayunos largos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cree que el reciclaje celular aumenta durante los ayunos largos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acredita-se que a reciclagem celular aumente durante jejuns mais longos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считается, что во время долгих голоданий усиливается клеточное самообновление."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вважається, що під час довших голодувань посилюється клітинне самооновлення."
          }
        }
      }
    },
    "phase.autophagy.title": {
      "extractionState": "manual",
      "localizations": {
