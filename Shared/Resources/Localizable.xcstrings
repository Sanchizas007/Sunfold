    "privacy.purchases.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases are processed by Apple. To check whether Sunfold Pro is active, the app uses RevenueCat, which receives a randomly generated app user ID and your App Store receipt. It never receives your name, your email, or anything you record in Sunfold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe werden von Apple abgewickelt. Um zu prüfen, ob Sunfold Pro aktiv ist, nutzt die App RevenueCat, das eine zufällig erzeugte App-Nutzer-ID und deinen App-Store-Beleg erhält. Es erhält nie deinen Namen, deine E-Mail-Adresse oder etwas, das du in Sunfold erfasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats sont traités par Apple. Pour vérifier si Sunfold Pro est actif, l’app utilise RevenueCat, qui reçoit un identifiant d’utilisateur généré aléatoirement et votre reçu App Store. Il ne reçoit jamais votre nom, votre e-mail, ni rien de ce que vous enregistrez dans Sunfold."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки обрабатывает Apple. Чтобы проверить, активен ли Sunfold Pro, приложение использует RevenueCat, который получает случайно сгенерированный идентификатор пользователя и ваш чек App Store. Он никогда не получает ваше имя, почту или что-либо записанное в Sunfold."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки обробляє Apple. Щоб перевірити, чи активний Sunfold Pro, застосунок використовує RevenueCat, який отримує випадково згенерований ідентифікатор користувача та ваш чек App Store. Він ніколи не отримує ваше ім'я, пошту чи будь-що записане в Sunfold."
          }
        }
      }
    },
