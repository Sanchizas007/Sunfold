          "stringUnit": {
            "state": "translated",
            "value": "На цьому Apple ID не знайдено попередніх покупок."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Apple ID не найдено прежних покупок."
          }
        }
      }
    },
