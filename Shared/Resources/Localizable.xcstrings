    "onboarding.health.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunfold is a timer and a journal. It is not a medical device and it gives no medical advice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
