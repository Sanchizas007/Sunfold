    "onboarding.ready.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first week has everything unlocked, so you can see the whole app before deciding anything."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deiner ersten Woche ist alles freigeschaltet, damit du die ganze App siehst, bevor du dich entscheidest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première semaine est entièrement débloquée, pour que vous voyiez toute l’app avant de décider quoi que ce soit."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu primera semana tiene todo desbloqueado, para que veas la app completa antes de decidir nada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu primera semana la tienes entera desbloqueada, para que veas toda la app antes de decidir nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua primeira semana vem com tudo liberado, para você ver o app inteiro antes de decidir qualquer coisa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prima settimana ha tutto sbloccato, così vedi l’app intera prima di decidere qualsiasi cosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eerste week is alles ontgrendeld, zodat je de hele app ziet voordat je iets beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pierwszym tygodniu masz odblokowane wszystko, żeby zobaczyć całą aplikację, zanim cokolwiek zdecydujesz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の1週間はすべての機能が使えます。決める前に、アプリの全体を見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 주에는 모든 기능이 열려 있습니다. 무엇을 정하기 전에 앱 전체를 살펴보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первую неделю всё открыто, чтобы вы увидели приложение целиком, прежде чем что-то решать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший тиждень усе відкрито, щоб ви побачили застосунок цілком, перш ніж щось вирішувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一周所有功能都已解锁，让你在做任何决定之前，先看完整个 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一週所有功能都已解鎖，讓你在做任何決定之前，先看完整個 App。"
          }
        }
