    "protocol.5_2.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two longer fasts a week, eating normally on the other days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal pro Woche länger fasten, an den anderen Tagen normal essen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux jeûnes plus longs par semaine, en mangeant normalement les autres jours."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos ayunos largos por semana, comiendo normal los demás días."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos ayunos largos por semana, comiendo con normalidad el resto de días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois jejuns mais longos por semana, comendo normalmente nos outros dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due digiuni più lunghi a settimana, mangiando normalmente negli altri giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee langere vastendagen per week, de andere dagen gewoon eten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa dłuższe posty w tygodniu, w pozostałe dni jesz normalnie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週に2回は長めの断食、残りの日はふだんどおりに食べます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два более долгих голодания в неделю, остальные дни — обычное питание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два довші голодування на тиждень, решту днів — звичайне харчування."
          }
        }
      }
    },
