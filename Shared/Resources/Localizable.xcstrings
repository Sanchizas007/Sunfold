    "protocols.custom.longNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasts of 24 hours or more are worth discussing with a doctor first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten ab 24 Stunden solltest du vorher ärztlich besprechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeûne de 24 heures ou plus mérite d’en parler d’abord à un médecin."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ayunos de 24 horas o más conviene consultarlos antes con un médico."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ayunos de 24 horas o más conviene consultarlos antes con un médico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejuns de 24 horas ou mais vale conversar antes com um médico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I digiuni di 24 ore o più è bene discuterli prima con un medico."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasten van 24 uur of langer bespreek je beter eerst met een arts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post trwający 24 godziny lub dłużej warto wcześniej omówić z lekarzem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24時間以上の断食は、事前に医師に相談することをおすすめします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание от 24 часов стоит сначала обсудить с врачом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодування від 24 годин варто спершу обговорити з лікарем."
          }
        }
      }
    },
    "protocols.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No schedule suits everyone. Pick the one that fits your day, and talk to a doctor if you are unsure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Rhythmus passt allen. Wähle den, der zu deinem Tag passt, und sprich mit einer Ärztin oder einem Arzt, wenn du unsicher bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun rythme ne convient à tout le monde. Choisissez celui qui s’accorde à votre journée, et parlez-en à un médecin en cas de doute."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún esquema le va bien a todo el mundo. Elige el que encaje con tu día y habla con tu médico si tienes dudas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna pauta le va bien a todo el mundo. Elige la que encaje con tu día y habla con tu médico si tienes dudas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum ritmo serve para todo mundo. Escolha o que combina com o seu dia, e fale com um médico se estiver em dúvida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno schema va bene per tutti. Scegli quello che si incastra con la tua giornata, e parla con un medico se hai dei dubbi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkel schema past bij iedereen. Kies het schema dat bij je dag past, en overleg met een arts als je twijfelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden plan nie pasuje wszystkim. Wybierz ten, który pasuje do twojego dnia, a w razie wątpliwości porozmawiaj z lekarzem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての人に合うスケジュールはありません。自分の一日に合うものを選び、迷うときは医師に相談してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один график не подходит всем. Выберите тот, что вписывается в ваш день, и посоветуйтесь с врачом, если сомневаетесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден графік не підходить усім. Оберіть той, що вписується у ваш день, і порадьтеся з лікарем, якщо сумніваєтесь."
          }
        }
      }
    },
