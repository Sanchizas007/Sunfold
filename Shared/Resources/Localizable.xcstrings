    "privacy.deletion.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings → Delete all data removes every fast, weight entry and note immediately. Deleting the app removes everything else."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen → Alle Daten löschen entfernt jedes Fasten, jeden Gewichtseintrag und jede Notiz sofort. Das Löschen der App entfernt alles Übrige."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages → Supprimer toutes les données retire immédiatement chaque jeûne, chaque pesée et chaque note. Supprimer l’app retire tout le reste."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes → Eliminar todos los datos borra de inmediato cada ayuno, cada registro de peso y cada nota. Eliminar la app borra todo lo demás."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes → Eliminar todos los datos borra al instante cada ayuno, cada registro de peso y cada nota. Eliminar la app borra todo lo demás."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes → Apagar todos os dados remove na hora cada jejum, cada registro de peso e cada nota. Apagar o app remove todo o resto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni → Elimina tutti i dati rimuove subito ogni digiuno, ogni peso e ogni nota. Eliminare l’app rimuove tutto il resto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen → Verwijder alle gegevens wist meteen elke vastenperiode, elk gewicht en elke notitie. De app verwijderen wist al het overige."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia → Usuń wszystkie dane natychmiast kasuje każdy post, każdy wpis wagi i każdą notatkę. Usunięcie aplikacji kasuje całą resztę."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 →「すべてのデータを削除」で、記録・体重・メモがすぐに消えます。アプリを削除すれば、残りもすべて消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 모든 데이터 삭제를 누르면 단식 기록, 체중, 메모가 바로 지워집니다. 앱을 삭제하면 나머지도 모두 사라집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки → Удалить все данные мгновенно убирает все голодания, записи веса и заметки. Удаление приложения убирает остальное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування → Видалити всі дані миттєво прибирає всі голодування, записи ваги й нотатки. Видалення застосунку прибирає решту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 →「删除所有数据」会立即移除每一次断食、每一条体重和每一条备注。删除 App 则会移除其余全部内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 →「刪除所有資料」會立即移除每一次斷食、每一筆體重和每一則備註。刪除 App 則會移除其餘全部內容。"
          }
        }
      }
    },
