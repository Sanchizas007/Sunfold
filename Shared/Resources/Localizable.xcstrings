    "onboarding.ready.point2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders when your fast ends — you choose whether to allow them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen am Ende des Fastens — du entscheidest, ob du sie erlaubst."
