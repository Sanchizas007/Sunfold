    "paywall.unavailable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. Everything you have already recorded is unaffected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Verbindung und versuche es erneut. Alles, was du bereits erfasst hast, bleibt unberührt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez. Tout ce que vous avez déjà enregistré reste intact."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu conexión e inténtalo de nuevo. Nada de lo que ya registraste se ve afectado."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión e inténtalo de nuevo. Nada de lo que ya has registrado se ve afectado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão e tente de novo. Nada do que você já registrou é afetado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la connessione e riprova. Tutto quello che hai già registrato non viene toccato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je verbinding en probeer het opnieuw. Alles wat je al hebt vastgelegd blijft ongemoeid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie i spróbuj ponownie. Nic z tego, co już zapisałeś, nie ucierpi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。すでに記録した内容には影響ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 확인하고 다시 시도하세요. 이미 기록한 내용에는 영향이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте соединение и попробуйте снова. Всё, что вы уже записали, в порядке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте з'єднання і спробуйте ще раз. Усе, що ви вже записали, у безпеці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络后重试。你已经记录的内容不会受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查網路後重試。你已經記錄的內容不會受到影響。"
          }
        }
      }
    },
