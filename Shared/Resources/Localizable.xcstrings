    "protocols.custom.longNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasts of 24 hours or more are worth discussing with a doctor first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодування від 24 годин варто спершу обговорити з лікарем."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание от 24 часов стоит сначала обсудить с врачом."
          }
        }
      }
    },
    "protocols.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No schedule suits everyone. Pick the one that fits your day, and talk to a doctor if you are unsure."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден графік не підходить усім. Оберіть той, що вписується у ваш день, і порадьтеся з лікарем, якщо сумніваєтесь."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один график не подходит всем. Выберите тот, что вписывается в ваш день, и посоветуйтесь с врачом, если сомневаетесь."
          }
        }
      }
    },
