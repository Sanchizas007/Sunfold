          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer à tout moment, même en plein jeûne."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo cuando quieras, incluso a mitad del ayuno."
