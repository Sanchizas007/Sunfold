    "privacy.children.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold is not directed at children and is not intended for anyone under 18 without medical supervision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold richtet sich nicht an Kinder und ist ohne ärztliche Begleitung nicht für Personen unter 18 Jahren gedacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold ne s’adresse pas aux enfants et n’est pas destiné aux personnes de moins de 18 ans sans suivi médical."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold no está dirigida a menores y no está pensada para personas menores de 18 años sin supervisión médica."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold no está dirigida a menores y no está pensada para personas menores de 18 años sin supervisión médica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunfold não é voltado a crianças e não é destinado a menores de 18 anos sem acompanhamento médico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold non si rivolge ai bambini e non è pensata per chi ha meno di 18 anni senza controllo medico."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold is niet gericht op kinderen en niet bedoeld voor wie jonger is dan 18 zonder medisch toezicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold nie jest kierowany do dzieci ani przeznaczony dla osób poniżej 18 lat bez nadzoru lekarza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfoldは子ども向けではなく、医師の管理なしに18歳未満の方が使うことを想定していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold는 어린이를 대상으로 하지 않으며, 의료진의 관리 없이 18세 미만이 사용하도록 만들어지지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold не предназначена для детей и не рекомендована лицам до 18 лет без наблюдения врача."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold не призначена для дітей і не рекомендована особам до 18 років без нагляду лікаря."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 不面向儿童，也不适合未满 18 岁且没有医疗监督的人使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 並非面向兒童，也不適合未滿 18 歲且沒有醫療監督的人使用。"
          }
        }
      }
    },
