      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A step up from 16:8, once that has become routine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stufe über 16:8, sobald das zur Routine geworden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cran au-dessus du 16:8, une fois qu’il est devenu une habitude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий шаг после 16:8, когда тот вошёл в привычку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступний крок після 16:8, коли той увійшов у звичку."
          }
        }
      }
    },
