    "phases.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These hours are approximations drawn from general research. What actually happens depends on your last meal, your activity and your body. This is educational information, not medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Stunden sind Näherungswerte aus allgemeiner Forschung. Was tatsächlich passiert, hängt von deiner letzten Mahlzeit, deiner Bewegung und deinem Körper ab. Das sind Informationen zur Aufklärung, keine medizinische Beratung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces heures sont des approximations issues de la recherche générale. Ce qui se passe réellement dépend de votre dernier repas, de votre activité et de votre corps. Il s’agit d’information générale, pas d’un avis médical."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas horas son aproximaciones tomadas de investigación general. Lo que ocurre en realidad depende de tu última comida, tu actividad y tu cuerpo. Es información educativa, no consejo médico."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas horas son aproximaciones tomadas de la investigación general. Lo que ocurre en realidad depende de tu última comida, tu actividad y tu cuerpo. Es información divulgativa, no consejo médico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas horas são aproximações vindas de pesquisas gerais. O que acontece de verdade depende da sua última refeição, da sua atividade e do seu corpo. É informação educativa, não orientação médica."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste ore sono approssimazioni tratte dalla ricerca generale. Quello che succede davvero dipende dal tuo ultimo pasto, dalla tua attività e dal tuo corpo. È informazione divulgativa, non un parere medico."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze uren zijn benaderingen uit algemeen onderzoek. Wat er werkelijk gebeurt hangt af van je laatste maaltijd, je beweging en je lichaam. Dit is informatie ter kennisgeving, geen medisch advies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te godziny to przybliżenia z ogólnych badań. To, co dzieje się naprawdę, zależy od twojego ostatniego posiłku, aktywności i organizmu. To informacja edukacyjna, nie porada lekarska."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに示す時間は、一般的な研究にもとづくおおよその目安です。実際に起こることは、直前の食事、活動、そして体質によって変わります。これは教育目的の情報であり、医学的助言ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기 적힌 시간은 일반 연구에서 나온 대략적인 값입니다. 실제로 일어나는 일은 마지막 식사, 활동량, 몸 상태에 따라 달라집니다. 참고 정보이며 의학적 조언이 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти часы — приблизительные ориентиры из общих исследований. Что происходит на самом деле, зависит от последнего приёма пищи, активности и вашего организма. Это образовательная информация, а не медицинский совет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці години — приблизні орієнтири із загальних досліджень. Що відбувається насправді, залежить від останнього прийому їжі, активності та вашого організму. Це освітня інформація, а не медична порада."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些小时数是来自一般研究的近似值。真正发生的情况取决于你的上一餐、活动量和你的身体。这是科普信息，不是医疗建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些小時數是來自一般研究的近似值。真正發生的情況取決於你的上一餐、活動量和你的身體。這是知識資訊，不是醫療建議。"
          }
        }
      }
    },
