          }
        }
      }
    },
    "paywall.terms.lifetime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single payment with no renewal. Sunfold Pro stays with your Apple ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einmalige Zahlung ohne Verlängerung. Sunfold Pro bleibt bei deiner Apple-ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paiement unique, sans renouvellement. Sunfold Pro reste lié à votre identifiant Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один платёж без продления. Sunfold Pro остаётся на вашем Apple ID."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один платіж без поновлення. Sunfold Pro залишається на вашому Apple ID."
          }
        }
      }
    },
    "paywall.terms.subscription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple ID. The subscription renews automatically unless it is cancelled at least 24 hours before the period ends. Manage or cancel it any time in App Store settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird über deine Apple-ID abgerechnet. Das Abo verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ende des Zeitraums gekündigt wird. Du kannst es jederzeit in den App-Store-Einstellungen verwalten oder kündigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de votre identifiant Apple. L’abonnement se renouvelle automatiquement sauf résiliation au moins 24 heures avant la fin de la période. Vous pouvez le gérer ou le résilier à tout moment dans les réglages de l’App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списывается с вашего Apple ID. Подписка продлевается автоматически, если её не отменить минимум за 24 часа до конца периода. Управлять или отменить можно в любой момент в настройках App Store."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списується з вашого Apple ID. Підписка поновлюється автоматично, якщо її не скасувати щонайменше за 24 години до кінця періоду. Керувати чи скасувати можна будь-коли в налаштуваннях App Store."
          }
        }
      }
    },
    "paywall.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
