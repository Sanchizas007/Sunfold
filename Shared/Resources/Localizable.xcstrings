    "settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold keeps everything on your device. No account, no server, no tracking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold behält alles auf deinem Gerät. Kein Account, kein Server, kein Tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold garde tout sur votre appareil. Pas de compte, pas de serveur, pas de pistage."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold guarda todo en tu dispositivo. Sin cuenta, sin servidor, sin rastreo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold lo guarda todo en tu dispositivo. Sin cuenta, sin servidor, sin rastreo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunfold guarda tudo no seu dispositivo. Sem conta, sem servidor, sem rastreamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold хранит всё на вашем устройстве. Без аккаунта, без сервера, без слежки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold зберігає все на вашому пристрої. Без акаунта, без сервера, без стеження."
