        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esta política cambia, la versión actualizada aparecerá aquí y en la propia app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esta política mudar, a versão atualizada aparece aqui e no próprio app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se questa informativa cambia, la versione aggiornata compare qui e nell’app stessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit beleid verandert, verschijnt de bijgewerkte versie hier en in de app zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ta polityka się zmieni, zaktualizowana wersja pojawi się tutaj i w samej aplikacji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このポリシーが変わった場合、更新版はこことアプリ内に掲載されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если политика изменится, обновлённая версия появится здесь и в самом приложении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо політика зміниться, оновлена версія з'явиться тут і в самому застосунку."
          }
        }
      }
    },
