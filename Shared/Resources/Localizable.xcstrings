    "privacy.health.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold does not read from or write to Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold liest nichts aus Apple Health und schreibt nichts dorthin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold ne lit rien dans Apple Santé et n’y écrit rien."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold no lee ni escribe nada en Apple Salud."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold no lee ni escribe nada en Apple Salud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunfold não lê nem escreve nada no app Saúde da Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold non legge né scrive nulla in Apple Salute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold leest niets uit Apple Gezondheid en schrijft er niets naartoe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold nie czyta z aplikacji Zdrowie ani nic do niej nie zapisuje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SunfoldはAppleのヘルスケアを読み書きしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold는 Apple Health에서 읽지도, 그곳에 쓰지도 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold не читает и не записывает данные в Apple Health."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold не читає та не записує дані в Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 不读取「健康」App 的数据，也不向其写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 不讀取「健康」App 的資料，也不寫入其中。"
          }
        }
      }
    },
