    "disclaimer.askFirst.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please speak to a healthcare professional before fasting if you are pregnant or breastfeeding, under 18, living with diabetes or taking medication that affects blood sugar, taking any medicine that must be taken with food, underweight, or living with a chronic condition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte sprich vor dem Fasten mit einer Ärztin oder einem Arzt, wenn du schwanger bist oder stillst, unter 18 bist, mit Diabetes lebst oder Medikamente nimmst, die den Blutzucker beeinflussen, Medikamente einnimmst, die zu einer Mahlzeit gehören, untergewichtig bist oder eine chronische Erkrankung hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez-en à un professionnel de santé avant de jeûner si vous êtes enceinte ou allaitez, avez moins de 18 ans, vivez avec un diabète ou prenez un traitement qui agit sur la glycémie, prenez un médicament à prendre au cours d’un repas, êtes en insuffisance pondérale ou vivez avec une maladie chronique."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con un profesional de la salud antes de ayunar si estás embarazada o amamantando, eres menor de 18 años, vives con diabetes o tomas medicamentos que afectan el azúcar en sangre, tomas algún medicamento que debe tomarse con alimentos, tienes bajo peso o vives con una enfermedad crónica."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con un profesional sanitario antes de ayunar si estás embarazada o dando el pecho, eres menor de 18 años, convives con diabetes o tomas medicación que afecta al azúcar en sangre, tomas algún medicamento que debe tomarse con comida, tienes bajo peso o convives con una enfermedad crónica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converse com um profissional de saúde antes de jejuar se você estiver grávida ou amamentando, tiver menos de 18 anos, viver com diabetes ou tomar medicamentos que afetam o açúcar no sangue, tomar algum remédio que precisa ser tomado com comida, estiver abaixo do peso ou viver com uma condição crônica."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla con un professionista sanitario prima di digiunare se sei incinta o stai allattando, hai meno di 18 anni, convivi con il diabete o assumi farmaci che agiscono sulla glicemia, prendi medicinali da assumere durante i pasti, sei sottopeso o convivi con una malattia cronica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overleg met een zorgverlener voordat je gaat vasten als je zwanger bent of borstvoeding geeft, jonger bent dan 18, diabetes hebt of medicijnen gebruikt die de bloedsuiker beïnvloeden, medicijnen gebruikt die je bij een maaltijd moet innemen, ondergewicht hebt of een chronische aandoening hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porozmawiaj z lekarzem przed rozpoczęciem postu, jeśli jesteś w ciąży lub karmisz piersią, masz mniej niż 18 lat, chorujesz na cukrzycę lub przyjmujesz leki wpływające na poziom cukru we krwi, bierzesz leki, które trzeba przyjmować z posiłkiem, masz niedowagę lub chorobę przewlekłą."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "妊娠中または授乳中の方、18歳未満の方、糖尿病のある方や血糖値に影響する薬を服用している方、食事と一緒に飲む必要のある薬を服用している方、低体重の方、慢性疾患のある方は、ファスティングを始める前に医療専門家にご相談ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임신 중이거나 모유 수유 중인 경우, 18세 미만인 경우, 당뇨가 있거나 혈당에 영향을 주는 약을 복용하는 경우, 음식과 함께 먹어야 하는 약을 복용하는 경우, 저체중인 경우, 만성 질환이 있는 경우에는 단식을 시작하기 전에 의료 전문가와 상담하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратитесь к врачу перед голоданием, если вы беременны или кормите грудью, вам меньше 18 лет, у вас диабет или вы принимаете лекарства, влияющие на уровень сахара, принимаете любые лекарства, которые надо пить с едой, имеете недостаточный вес или хроническое заболевание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверніться до лікаря перед голодуванням, якщо ви вагітні чи годуєте груддю, вам менше 18 років, у вас діабет або ви приймаєте ліки, що впливають на рівень цукру, приймаєте будь-які ліки, які треба пити з їжею, маєте недостатню вагу чи хронічне захворювання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你正在怀孕或哺乳、未满 18 岁、患有糖尿病或正在服用影响血糖的药物、服用必须随餐服下的药物、体重过轻，或患有慢性疾病，请在开始断食前先咨询医疗专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你正在懷孕或哺乳、未滿 18 歲、患有糖尿病或正在服用影響血糖的藥物、服用必須隨餐服下的藥物、體重過輕，或患有慢性疾病，請在開始斷食前先諮詢醫療專業人員。"
          }
        }
      }
    },
    "disclaimer.askFirst.title": {
