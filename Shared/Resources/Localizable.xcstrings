    "onboarding.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm timer for intermittent fasting. No feed, no streak-shaming, no ads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhiger Timer für Intervallfasten. Kein Feed, kein Serien-Druck, keine Werbung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un minuteur paisible pour le jeûne intermittent. Pas de fil d’actualité, pas de culpabilisation, pas de publicité."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un temporizador tranquilo para el ayuno intermitente. Sin feed, sin presión por la racha, sin anuncios."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un temporizador tranquilo para el ayuno intermitente. Sin feed, sin presión por la racha, sin anuncios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cronômetro tranquilo para o jejum intermitente. Sem feed, sem cobrança por sequência, sem anúncios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un timer tranquillo per il digiuno intermittente. Niente feed, niente pressione sulle serie, niente pubblicità."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rustige timer voor periodiek vasten. Geen tijdlijn, geen druk om de reeks, geen advertenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojny minutnik do postu przerywanego. Bez tablicy, bez presji serii, bez reklam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間欠的ファスティングのための、静かなタイマー。フィードも、連続記録を責める表示も、広告もありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойный таймер для интервального голодания. Без ленты, без упрёков за сорванную серию, без рекламы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійний таймер для інтервального голодування. Без стрічки, без докорів за зірвану серію, без реклами."
          }
        }
      }
    },
