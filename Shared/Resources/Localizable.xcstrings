    "notification.windowEnd.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to start the next fast when you are ready."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
