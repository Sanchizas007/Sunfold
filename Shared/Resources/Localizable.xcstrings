    "protocol.20_4.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One long fast and a short window. Demanding — worth easing into."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein langes Fasten und ein kurzes Fenster. Fordernd — taste dich heran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un long jeûne et une fenêtre courte. Exigeant — mieux vaut y aller progressivement."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ayuno largo y una ventana corta. Exigente: conviene llegar poco a poco."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ayuno largo y una ventana corta. Exigente: mejor llegar poco a poco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jejum longo e uma janela curta. Exigente — vale ir aos poucos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un digiuno lungo e una finestra breve. Impegnativo: meglio arrivarci con calma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén lange vastenperiode en een kort venster. Pittig — bouw het rustig op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden długi post i krótkie okno. Wymagające — lepiej dochodzić do tego stopniowo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い断食と短い食事時間。負担が大きいので、少しずつ慣らしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 단식과 짧은 식사 시간. 부담이 크니 천천히 적응하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долгое голодание и короткое окно. Требовательный режим — заходите постепенно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довге голодування й коротке вікно. Вимогливий режим — заходьте поступово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一段长断食和一个短窗口。有难度，值得慢慢适应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一段長斷食和一個短窗口。有難度，值得慢慢適應。"
          }
        }
      }
    },
