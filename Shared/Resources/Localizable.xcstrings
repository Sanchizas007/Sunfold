    "disclaimer.lede": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold tracks when you eat. It cannot know anything about your health, and it does not diagnose, treat or advise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold erfasst, wann du isst. Über deine Gesundheit kann es nichts wissen, und es stellt keine Diagnosen, behandelt nicht und berät nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold enregistre quand vous mangez. Il ne peut rien savoir de votre santé, et il ne diagnostique pas, ne traite pas et ne conseille pas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold registra cuándo comes. No puede saber nada sobre tu salud, y no diagnostica, no trata ni aconseja."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold registra cuándo comes. No puede saber nada sobre tu salud, y no diagnostica, no trata ni aconseja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunfold registra quando você come. Ele não tem como saber nada sobre a sua saúde, e não diagnostica, não trata e não aconselha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold registra quando mangi. Non può sapere nulla della tua salute, e non diagnostica, non cura e non dà consigli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold houdt bij wanneer je eet. Het kan niets weten over je gezondheid, en het stelt geen diagnose, behandelt niet en adviseert niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold zapisuje, kiedy jesz. Nie wie nic o twoim zdrowiu, nie diagnozuje, nie leczy i nie doradza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfoldは食事のタイミングを記録します。あなたの健康状態について知ることはできず、診断も治療も助言も行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold는 언제 먹었는지를 기록합니다. 건강 상태에 대해서는 아무것도 알 수 없으며, 진단하거나 치료하거나 조언하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold отслеживает, когда вы едите. Она ничего не знает о вашем здоровье и не диагностирует, не лечит и не советует."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold відстежує, коли ви їсте. Вона нічого не знає про ваше здоров'я й не діагностує, не лікує та не радить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 记录你什么时候进食。它无法了解你的健康状况，也不做诊断、治疗或建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 記錄你什麼時候進食。它無法了解你的健康狀況，也不做診斷、治療或建議。"
          }
        }
      }
    },
    "disclaimer.notMedical.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in Sunfold, including the metabolic phases, is general educational information. It is not a diagnosis, a treatment plan, or a recommendation for you personally."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in Sunfold, auch die Stoffwechselphasen, sind allgemeine Informationen zur Aufklärung. Sie sind keine Diagnose, kein Behandlungsplan und keine Empfehlung für dich persönlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que contient Sunfold, y compris les phases métaboliques, relève de l’information générale. Ce n’est ni un diagnostic, ni un plan de traitement, ni une recommandation vous concernant personnellement."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que hay en Sunfold, incluidas las fases metabólicas, es información general con fines educativos. No es un diagnóstico, ni un plan de tratamiento, ni una recomendación para ti en particular."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que hay en Sunfold, incluidas las fases metabólicas, es información general con fines divulgativos. No es un diagnóstico, ni un plan de tratamiento, ni una recomendación para ti en particular."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo no Sunfold, inclusive as fases metabólicas, é informação geral de caráter educativo. Não é um diagnóstico, nem um plano de tratamento, nem uma recomendação para você em particular."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che trovi in Sunfold, fasi metaboliche comprese, è informazione generale a scopo divulgativo. Non è una diagnosi, né un piano di cura, né una raccomandazione per te in particolare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in Sunfold, ook de stofwisselingsfasen, is algemene informatie ter kennisgeving. Het is geen diagnose, geen behandelplan en geen aanbeveling voor jou persoonlijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko w Sunfold, łącznie z fazami metabolicznymi, to ogólna informacja edukacyjna. To nie jest diagnoza, plan leczenia ani zalecenie skierowane do ciebie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代謝フェーズを含め、Sunfoldの内容はすべて一般的な教育目的の情報です。診断でも治療計画でも、あなた個人への推奨でもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대사 단계를 포함해 Sunfold의 모든 내용은 일반적인 참고 정보입니다. 진단도, 치료 계획도, 개인을 위한 권고도 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в Sunfold, включая фазы метаболизма, — общая образовательная информация. Это не диагноз, не план лечения и не рекомендация лично для вас."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе в Sunfold, включно з фазами метаболізму, — загальна освітня інформація. Це не діагноз, не план лікування й не рекомендація особисто для вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 中的所有内容，包括代谢阶段，都是一般性的科普信息。它不是诊断，不是治疗方案，也不是针对你个人的建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold 中的所有內容，包括代謝階段，都是一般性的知識資訊。它不是診斷，不是治療計畫，也不是針對你個人的建議。"
          }
        }
      }
    },
