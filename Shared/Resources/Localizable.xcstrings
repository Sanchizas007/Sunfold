    "privacy.lede": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold has no account, no server and no analytics. Everything you record lives on your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold hat keinen Account, keinen Server und keine Analyse. Alles, was du erfasst, bleibt auf deinem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold n’a ni compte, ni serveur, ni analyse d’audience. Tout ce que vous enregistrez reste sur votre appareil."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold no tiene cuenta, ni servidor, ni analítica. Todo lo que registras vive en tu dispositivo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunfold no tiene cuenta, ni servidor, ni analítica. Todo lo que registras vive en tu dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunfold não tem conta, nem servidor, nem análise de uso. Tudo o que você registra fica no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Sunfold нет аккаунта, сервера и аналитики. Всё, что вы записываете, живёт на вашем устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Sunfold немає акаунта, сервера й аналітики. Усе, що ви записуєте, живе на вашому пристрої."
          }
        }
      }
    },
    "privacy.notCollected.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no email address, no advertising identifiers, no analytics or tracking SDKs, no location. Nothing you record is sent anywhere, because Sunfold has no server to send it to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Account, keine E-Mail-Adresse, keine Werbe-IDs, keine Analyse- oder Tracking-SDKs, kein Standort. Nichts von dem, was du erfasst, wird irgendwohin gesendet, denn Sunfold hat keinen Server, an den es gesendet werden könnte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas d’adresse e-mail, pas d’identifiant publicitaire, pas de SDK d’analyse ou de pistage, pas de localisation. Rien de ce que vous enregistrez n’est envoyé où que ce soit, car Sunfold n’a aucun serveur où l’envoyer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin correo electrónico, sin identificadores publicitarios, sin SDK de analítica o rastreo, sin ubicación. Nada de lo que registras se envía a ningún sitio, porque Sunfold no tiene servidor al que enviarlo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin correo electrónico, sin identificadores publicitarios, sin SDK de analítica o rastreo, sin ubicación. Nada de lo que registras se envía a ningún sitio, porque Sunfold no tiene servidor al que enviarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem e-mail, sem identificadores de publicidade, sem SDKs de análise ou rastreamento, sem localização. Nada do que você registra é enviado a lugar nenhum, porque o Sunfold não tem servidor para onde enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни аккаунта, ни электронной почты, ни рекламных идентификаторов, ни аналитики или трекинговых SDK, ни геолокации. Ничего из записанного вами никуда не отправляется, потому что у Sunfold просто нет сервера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні акаунта, ні електронної пошти, ні рекламних ідентифікаторів, ні аналітики чи трекінгових SDK, ні геолокації. Нічого із записаного вами нікуди не надсилається, бо в Sunfold просто немає сервера."
          }
        }
      }
    },
    "privacy.notCollected.title": {
      "extractionState": "manual",
      "localizations": {
