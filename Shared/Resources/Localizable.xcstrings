    "settings.deleteAll.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every fast, weight entry and note will be removed from this device. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Fasten, jeder Gewichtseintrag und jede Notiz wird von diesem Gerät entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jeûne, chaque pesée et chaque note sera retiré de cet appareil. Cette action est irréversible."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ayuno, registro de peso y nota se borrará de este dispositivo. Esto no se puede deshacer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ayuno, registro de peso y nota se borrará de este dispositivo. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada jejum, registro de peso e nota será removido deste dispositivo. Isso não pode ser desfeito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni digiuno, ogni peso e ogni nota verrà rimosso da questo dispositivo. L’operazione non si può annullare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke vastenperiode, elk gewicht en elke notitie wordt van dit apparaat verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy post, wpis wagi i notatka zostaną usunięte z tego urządzenia. Tego nie da się cofnąć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録、体重、メモがこの端末から消えます。元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 기록, 체중, 메모가 이 기기에서 지워집니다. 되돌릴 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все голодания, записи веса и заметки будут удалены с этого устройства. Это нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі голодування, записи ваги та нотатки буде видалено з цього пристрою. Це не можна скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次断食、每一条体重和每一条备注都会从这台设备上移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次斷食、每一筆體重和每一則備註都會從這台裝置上移除。此操作無法還原。"
          }
        }
      }
    },
