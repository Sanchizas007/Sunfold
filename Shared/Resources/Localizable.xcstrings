        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если с едой сложно"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо з їжею складно"
          }
        }
      }
    },
    "disclaimer.heading": {
