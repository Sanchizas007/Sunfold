    "privacy.stored.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fasts, weight entries, notes and settings are saved on this device. If you have iPhone backups switched on, they are included in your own backup, which only you can open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fasten, Gewichtseinträge, Notizen und Einstellungen werden auf diesem Gerät gesichert. Wenn du iPhone-Backups aktiviert hast, sind sie in deinem eigenen Backup enthalten, das nur du öffnen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos jeûnes, vos pesées, vos notes et vos réglages sont enregistrés sur cet appareil. Si les sauvegardes iPhone sont activées, ils y sont inclus, et vous seul pouvez les ouvrir."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ayunos, registros de peso, notas y ajustes se guardan en este dispositivo. Si tienes activadas las copias de seguridad del iPhone, se incluyen en tu propia copia, que solo tú puedes abrir."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ayunos, registros de peso, notas y ajustes se guardan en este dispositivo. Si tienes activadas las copias de seguridad del iPhone, se incluyen en tu propia copia, que solo tú puedes abrir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus jejuns, registros de peso, notas e ajustes são salvos neste dispositivo. Se você tiver o backup do iPhone ligado, eles entram no seu próprio backup, que só você pode abrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi digiuni, i pesi, le note e le impostazioni sono salvati su questo dispositivo. Se hai attivato i backup di iPhone, finiscono nel tuo backup, che puoi aprire solo tu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vastenperiodes, gewichten, notities en instellingen worden op dit apparaat bewaard. Als je iPhone-reservekopieën aan hebt staan, horen ze bij je eigen reservekopie, die alleen jij kunt openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje posty, wpisy wagi, notatki i ustawienia są zapisane na tym urządzeniu. Jeśli masz włączone kopie zapasowe iPhone’a, trafiają do twojej własnej kopii, którą tylko ty możesz otworzyć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録、体重、メモ、設定はこの端末に保存されます。iPhoneのバックアップを有効にしている場合は、あなた自身だけが開けるバックアップに含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 기록, 체중, 메모, 설정은 이 기기에 저장됩니다. iPhone 백업을 켜 두었다면 본인만 열 수 있는 백업에 함께 담깁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши голодания, записи веса, заметки и настройки хранятся на этом устройстве. Если у вас включены резервные копии iPhone, они попадают в вашу собственную копию, которую можете открыть только вы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші голодування, записи ваги, нотатки й налаштування зберігаються на цьому пристрої. Якщо у вас увімкнено резервні копії iPhone, вони потрапляють до вашої власної копії, яку можете відкрити лише ви."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的断食记录、体重、备注和设置都保存在这台设备上。如果你开启了 iPhone 备份，它们会包含在只有你本人才能打开的备份里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的斷食紀錄、體重、備註和設定都儲存在這台裝置上。如果你開啟了 iPhone 備份，它們會包含在只有你本人才能打開的備份裡。"
          }
        }
      }
    },
