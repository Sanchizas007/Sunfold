    "privacy.notifications.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All reminders are scheduled locally by your iPhone. Sunfold has no push server, and notification content never leaves your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Erinnerungen plant dein iPhone lokal. Sunfold hat keinen Push-Server, und der Inhalt der Mitteilungen verlässt dein Gerät nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les rappels sont programmés localement par votre iPhone. Sunfold n’a pas de serveur de notifications, et leur contenu ne quitte jamais votre appareil."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los avisos los programa localmente tu iPhone. Sunfold no tiene servidor de notificaciones, y su contenido nunca sale de tu dispositivo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los avisos los programa localmente tu iPhone. Sunfold no tiene servidor de notificaciones, y su contenido nunca sale de tu dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os lembretes são agendados localmente pelo seu iPhone. O Sunfold não tem servidor de notificações, e o conteúdo delas nunca sai do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все напоминания планирует локально ваш iPhone. У Sunfold нет push-сервера, и содержимое уведомлений никогда не покидает ваше устройство."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі нагадування планує локально ваш iPhone. У Sunfold немає push-сервера, і вміст сповіщень ніколи не залишає ваш пристрій."
          }
        }
      }
    },
