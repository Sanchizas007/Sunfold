            "state": "translated",
            "value": "Ajoutez le widget et suivez le minuteur depuis l’écran verrouillé."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega el widget y mira el temporizador desde la pantalla bloqueada."
          }
        },
        "es-ES": {
          "stringUnit": {
