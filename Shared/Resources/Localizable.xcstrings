    "notification.endingSoon.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fast reaches its goal in half an hour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fasten erreicht sein Ziel in einer halben Stunde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jeûne atteint son objectif dans une demi-heure."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ayuno alcanza su meta en media hora."
