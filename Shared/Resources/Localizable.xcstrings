    "timer.longFast.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are about to start a fast of 24 hours or more. Long fasts are not right for everyone — if you have any health condition or take medication, please speak to a doctor first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du beginnst gleich ein Fasten von 24 Stunden oder mehr. Langes Fasten ist nicht für alle richtig — wenn du eine Erkrankung hast oder Medikamente nimmst, sprich bitte zuerst mit einer Ärztin oder einem Arzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous allez commencer un jeûne de 24 heures ou plus. Les jeûnes longs ne conviennent pas à tout le monde — si vous avez un problème de santé ou prenez un traitement, parlez-en d’abord à un médecin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы собираетесь начать голодание на 24 часа или дольше. Такие промежутки подходят не всем — если у вас есть заболевания или вы принимаете лекарства, сначала посоветуйтесь с врачом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви збираєтесь почати голодування на 24 години або довше. Такі проміжки підходять не всім — якщо у вас є будь-які захворювання чи ви приймаєте ліки, спершу порадьтеся з лікарем."
          }
        }
      }
    },
    "timer.longFast.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a long fast. Stop and eat if you feel dizzy, faint or unwell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein langes Fasten. Hör auf und iss, wenn dir schwindelig oder unwohl wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un jeûne long. Arrêtez et mangez si vous avez des vertiges ou vous sentez mal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это долгое голодание. Остановитесь и поешьте, если почувствуете головокружение, слабость или недомогание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це довге голодування. Зупиніться та поїжте, якщо відчуєте запаморочення, слабкість чи нездужання."
          }
        }
      }
    },
