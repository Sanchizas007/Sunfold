{
  "sourceLanguage": "en",
  "strings": {
    "a11y.eating": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eating window. Time left before the next fast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Essensfenster. Verbleibende Zeit bis zum nächsten Fasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtre alimentaire. Temps restant avant le prochain jeûne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно еды. Время до следующего голодания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікно їжі. Час до наступного голодування."
          }
        }
      }
    },
    "a11y.fasting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting in progress. Double tap to see the metabolic phases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten läuft. Doppeltippen, um die Stoffwechselphasen zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeûne en cours. Touchez deux fois pour voir les phases métaboliques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание идёт. Дважды коснитесь, чтобы увидеть фазы метаболизма."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодування триває. Двічі торкніться, щоб побачити фази метаболізму."
          }
        }
      }
    },
    "a11y.idle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fast running. Use the start button below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Fasten aktiv. Nutze die Starttaste unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jeûne en cours. Utilisez le bouton de démarrage ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание не идёт. Воспользуйтесь кнопкой старта ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодування не триває. Скористайтеся кнопкою старту нижче."
          }
        }
      }
    },
