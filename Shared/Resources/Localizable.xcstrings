{
  "sourceLanguage": "en",
  "strings": {
    "a11y.eating": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eating window. Time left before the next fast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Essensfenster. Verbleibende Zeit bis zum nächsten Fasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtre alimentaire. Temps restant avant le prochain jeûne."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventana de alimentación. Tiempo restante antes del próximo ayuno."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventana de alimentación. Tiempo restante antes del próximo ayuno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janela de alimentação. Tempo restante até o próximo jejum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finestra alimentare. Tempo rimasto prima del prossimo digiuno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eetvenster. Resterende tijd tot het volgende vasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno jedzenia. Czas pozostały do następnego postu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事の時間帯。次のファスティングまでの残り時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사 시간대입니다. 다음 단식까지 남은 시간입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно еды. Время до следующего голодания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікно їжі. Час до наступного голодування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进食时段。距离下一次断食的剩余时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進食時段。距離下一次斷食的剩餘時間。"
          }
        }
      }
    },
    "a11y.fasting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting in progress. Double tap to see the metabolic phases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten läuft. Doppeltippen, um die Stoffwechselphasen zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeûne en cours. Touchez deux fois pour voir les phases métaboliques."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuno en curso. Toca dos veces para ver las fases metabólicas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuno en curso. Toca dos veces para ver las fases metabólicas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejum em andamento. Toque duas vezes para ver as fases metabólicas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digiuno in corso. Tocca due volte per vedere le fasi metaboliche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasten bezig. Tik twee keer om de stofwisselingsfasen te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post w toku. Stuknij dwukrotnie, aby zobaczyć fazy metaboliczne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファスティング中。ダブルタップで代謝フェーズを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 진행 중입니다. 두 번 탭하면 대사 단계를 볼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание идёт. Дважды коснитесь, чтобы увидеть фазы метаболизма."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодування триває. Двічі торкніться, щоб побачити фази метаболізму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食进行中。轻点两下查看代谢阶段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "斷食進行中。點兩下可查看代謝階段。"
          }
        }
      }
    },
    "a11y.idle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fast running. Use the start button below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Fasten aktiv. Nutze die Starttaste unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jeûne en cours. Utilisez le bouton de démarrage ci-dessous."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ayuno en curso. Usa el botón de inicio de abajo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún ayuno en curso. Usa el botón de inicio de abajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum jejum em andamento. Use o botão de início abaixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun digiuno in corso. Usa il pulsante di avvio qui sotto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen vasten bezig. Gebruik de startknop hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden post nie trwa. Użyj przycisku startu poniżej."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファスティングは行われていません。下の開始ボタンを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 단식이 없습니다. 아래 시작 버튼을 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание не идёт. Воспользуйтесь кнопкой старта ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодування не триває. Скористайтеся кнопкою старту нижче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有进行中的断食。请使用下方的开始按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有進行中的斷食。請使用下方的開始按鈕。"
          }
        }
      }
    },
