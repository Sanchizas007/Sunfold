    "timer.end.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be saved to your history with the time you have fasted so far."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird mit der bisher gefasteten Zeit in deinem Verlauf gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera enregistré dans votre historique avec la durée déjà jeûnée."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardará en tu historial con el tiempo que llevas ayunando."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardará en tu historial con el tiempo que llevas ayunando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele será salvo no seu histórico com o tempo que você já jejuou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà salvato nella cronologia con il tempo che hai digiunato finora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt in je geschiedenis bewaard met de tijd die je tot nu toe hebt gevast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie zapisany w historii z czasem, który już pościłeś."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここまでの時間とともに履歴へ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 단식한 시간과 함께 기록에 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно сохранится в истории с тем временем, которое вы уже проголодали."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його буде збережено в історії з тим часом, який ви вже проголодували."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会连同你目前断食的时长一起存入历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會連同你目前斷食的時長一起存入紀錄。"
          }
        }
      }
    },
