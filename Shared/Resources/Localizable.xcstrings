    "phase.early.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glycogen — glucose stored in the liver and muscles — usually covers energy needs through this window."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glykogen — in Leber und Muskeln gespeicherte Glukose — deckt den Energiebedarf in diesem Zeitraum meist ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le glycogène — le glucose stocké dans le foie et les muscles — couvre généralement les besoins en énergie sur cette période."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El glucógeno —glucosa almacenada en el hígado y los músculos— suele cubrir las necesidades de energía durante este periodo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El glucógeno —glucosa almacenada en el hígado y los músculos— suele cubrir las necesidades de energía durante este periodo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O glicogênio — glicose armazenada no fígado e nos músculos — costuma cobrir a necessidade de energia nesse período."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il glicogeno — glucosio immagazzinato nel fegato e nei muscoli — di solito copre il fabbisogno di energia in questa fase."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glycogeen — glucose opgeslagen in lever en spieren — dekt in deze periode meestal de energiebehoefte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glikogen — glukoza zmagazynowana w wątrobie i mięśniach — zwykle pokrywa zapotrzebowanie na energię w tym okresie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリコーゲン（肝臓と筋肉に蓄えられたブドウ糖）が、この時間帯のエネルギーをまかなうのが一般的です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간과 근육에 저장된 포도당인 글리코겐이 보통 이 구간의 에너지를 충당합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гликоген — глюкоза, запасённая в печени и мышцах, — обычно покрывает потребность в энергии в этом промежутке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Глікоген — глюкоза, запасена в печінці та м'язах, — зазвичай покриває потребу в енергії протягом цього проміжку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "糖原——储存在肝脏和肌肉中的葡萄糖——通常足以覆盖这一阶段的能量需要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "肝醣——儲存在肝臟和肌肉中的葡萄糖——通常足以支應這一階段的能量需求。"
          }
        }
      }
    },
    "phase.early.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insulin falls and the liver begins releasing stored glucose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Insulin sinkt, und die Leber gibt gespeicherte Glukose ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’insuline baisse et le foie commence à libérer le glucose stocké."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La insulina baja y el hígado empieza a liberar glucosa almacenada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La insulina baja y el hígado empieza a liberar glucosa almacenada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A insulina cai e o fígado começa a liberar glicose armazenada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’insulina cala e il fegato inizia a rilasciare il glucosio immagazzinato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De insuline daalt en de lever geeft opgeslagen glucose af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Insulina spada, a wątroba zaczyna uwalniać zmagazynowaną glukozę."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスリンが下がり、肝臓が蓄えたブドウ糖を放出しはじめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인슐린이 떨어지고 간이 저장된 포도당을 내보내기 시작합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсулин снижается, и печень начинает отдавать запасы глюкозы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсулін знижується, і печінка починає віддавати запаси глюкози."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胰岛素下降，肝脏开始释放储存的葡萄糖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "胰島素下降，肝臟開始釋出儲存的葡萄糖。"
          }
        }
      }
    },
    "phase.early.title": {
