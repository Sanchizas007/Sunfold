          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pagamento unico senza rinnovo. Sunfold Pro resta legato al tuo ID Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén betaling zonder verlenging. Sunfold Pro blijft bij je Apple ID."
          }
        },
        "pl": {
          "stringUnit": {
