    "phase.ketosis.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some people report steadier energy and less hunger here; others notice nothing in particular. Both are normal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche berichten hier von gleichmäßigerer Energie und weniger Hunger, andere bemerken nichts Besonderes. Beides ist normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines personnes rapportent ici une énergie plus stable et moins de faim ; d’autres ne remarquent rien de particulier. Les deux sont normaux."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas personas notan aquí energía más estable y menos hambre; otras no notan nada en particular. Las dos cosas son normales."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas personas notan aquí energía más estable y menos hambre; otras no notan nada en particular. Las dos cosas son normales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas pessoas relatam energia mais estável e menos fome aqui; outras não notam nada em especial. Os dois são normais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune persone qui notano energia più stabile e meno fame; altre non notano nulla di particolare. Entrambe le cose sono normali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige mensen merken hier gelijkmatiger energie en minder honger; anderen merken niets bijzonders. Allebei is normaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część osób odczuwa tu równiejszą energię i mniejszy głód; inne nie zauważają nic szczególnego. Jedno i drugie jest normalne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間帯にエネルギーが安定し空腹が和らぐと感じる人もいれば、特に何も感じない人もいます。どちらも普通のことです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구간에서 에너지가 고르고 배고픔이 덜하다는 사람도 있고, 별다른 변화를 못 느끼는 사람도 있습니다. 둘 다 정상입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то отмечает более ровную энергию и меньший голод, кто-то не замечает ничего особенного. Оба варианта нормальны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дехто відзначає рівнішу енергію та менший голод, дехто не помічає нічого особливого. Обидва варіанти нормальні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些人在这里感到精力更平稳、饥饿感更少；也有人没什么特别感觉。两种情况都正常。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些人在這裡覺得精力更平穩、飢餓感更少；也有人沒什麼特別感覺。兩種情況都正常。"
          }
        }
      }
    },
    "phase.ketosis.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The liver produces ketones from fat, which the brain can use as fuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leber bildet aus Fett Ketone, die das Gehirn als Brennstoff nutzen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foie produit des cétones à partir des graisses, que le cerveau peut utiliser."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El hígado produce cetonas a partir de la grasa, que el cerebro puede usar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El hígado produce cetonas a partir de la grasa, que el cerebro puede usar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fígado produz cetonas a partir da gordura, que o cérebro consegue usar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fegato produce chetoni dai grassi, che il cervello può usare come carburante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lever maakt ketonen uit vet, die de hersenen als brandstof kunnen gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wątroba wytwarza z tłuszczu ketony, których mózg może używać jako paliwa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肝臓が脂肪からケトン体をつくり、脳はそれを燃料として使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간이 지방에서 케톤을 만들고, 뇌가 이를 연료로 쓸 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печень вырабатывает кетоны из жира, и мозг может использовать их как топливо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Печінка виробляє кетони з жиру, і мозок може використовувати їх як паливо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肝脏用脂肪生成酮体，大脑可以把它当作燃料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "肝臟用脂肪生成酮體，大腦可以把它當作燃料。"
          }
        }
      }
    },
