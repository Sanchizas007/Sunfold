    "phase.fed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood sugar and insulin typically rise after eating, and energy comes from the meal rather than from stores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutzucker und Insulin steigen nach dem Essen üblicherweise an, und die Energie kommt aus der Mahlzeit statt aus den Speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La glycémie et l’insuline montent généralement après le repas, et l’énergie vient du repas plutôt que des réserves."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El azúcar en sangre y la insulina suelen subir después de comer, y la energía viene de la comida y no de las reservas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El azúcar en sangre y la insulina suelen subir después de comer, y la energía viene de la comida y no de las reservas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O açúcar no sangue e a insulina costumam subir depois de comer, e a energia vem da refeição, não das reservas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Glicemia e insulina salgono di solito dopo aver mangiato, e l’energia arriva dal pasto invece che dalle riserve."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloedsuiker en insuline stijgen meestal na het eten, en de energie komt uit de maaltijd in plaats van uit de voorraden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cukier we krwi i insulina zwykle rosną po jedzeniu, a energia pochodzi z posiłku, nie z zapasów."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食後は血糖値とインスリンが上がり、エネルギーは蓄えではなく食事からまかなわれます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После еды сахар в крови и инсулин обычно растут, и энергия берётся из пищи, а не из запасов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після їжі цукор у крові й інсулін зазвичай зростають, і енергія береться з їжі, а не із запасів."
          }
        }
      }
    },
    "phase.fed.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body is digesting the last meal and running on it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Körper verdaut die letzte Mahlzeit und lebt von ihr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps digère le dernier repas et fonctionne avec."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo está digiriendo la última comida y funcionando con ella."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo está digiriendo la última comida y funcionando con ella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu corpo está digerindo a última refeição e funcionando com ela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo corpo sta digerendo l’ultimo pasto e ci sta funzionando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lichaam verteert de laatste maaltijd en draait daarop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizm trawi ostatni posiłek i na nim pracuje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体は直前の食事を消化し、それを使って動いています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Организм переваривает последний приём пищи и живёт на нём."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Організм перетравлює останній прийом їжі й живиться ним."
          }
        }
      }
    },
