    "timer.idle.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start whenever you finish your last meal. Sunfold counts from that moment and tells you when your goal is reached."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте таймер після останнього прийому їжі. Sunfold рахує від цієї миті й повідомить, коли ціль досягнуто."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте таймер после последнего приёма пищи. Sunfold считает с этого момента и сообщит, когда цель достигнута."
          }
        }
      }
    },
