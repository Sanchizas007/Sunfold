    "onboarding.protocol.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure? 16:8 is where most people start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicher? Mit 16:8 fangen die meisten an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous hésitez ? La plupart des gens commencent par 16:8."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No sabes cuál? La mayoría empieza con 16:8."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo tienes claro? La mayoría empieza con 16:8."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dúvida? A maioria começa com 16:8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai dei dubbi? La maggior parte inizia con il 16:8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet zeker? De meeste mensen beginnen met 16:8."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wiesz, co wybrać? Większość zaczyna od 16:8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷ったら16:8から。多くの人がここから始めます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не уверены? Большинство начинает с 16:8."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не впевнені? Більшість починає з 16:8."
          }
        }
      }
    },
    "onboarding.protocol.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this at any time, even mid-fast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
