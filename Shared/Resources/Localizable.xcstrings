    "timer.end.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be saved to your history with the time you have fasted so far."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird mit der bisher gefasteten Zeit in deinem Verlauf gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera enregistré dans votre historique avec la durée déjà jeûnée."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardará en tu historial con el tiempo que llevas ayunando."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardará en tu historial con el tiempo que llevas ayunando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele será salvo no seu histórico com o tempo que você já jejuou."
