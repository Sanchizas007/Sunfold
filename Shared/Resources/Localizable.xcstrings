    "phase.fat.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shift is gradual rather than a switch, and how quickly it happens varies a great deal between people."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel ist allmählich und kein Schalter, und wie schnell er geschieht, ist von Mensch zu Mensch sehr verschieden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passage est progressif plutôt qu’un basculement, et sa rapidité varie beaucoup d’une personne à l’autre."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio es gradual, no un interruptor, y la rapidez con que ocurre varía mucho de una persona a otra."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio es gradual, no un interruptor, y lo rápido que ocurre varía mucho de una persona a otra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mudança é gradual, não um interruptor, e a rapidez com que acontece varia muito de pessoa para pessoa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passaggio è graduale, non un interruttore, e la rapidità con cui avviene cambia molto da persona a persona."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De omslag gaat geleidelijk en is geen schakelaar, en hoe snel het gaat verschilt sterk per persoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejście jest stopniowe, a nie przełącznikowe, i tempo bardzo się różni między ludźmi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替わりはスイッチのようではなく緩やかで、その速さは人によって大きく異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환은 스위치가 아니라 서서히 일어나며, 그 속도는 사람마다 크게 다릅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход постепенный, а не мгновенный, и его скорость сильно различается у разных людей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перехід поступовий, а не миттєвий, і його швидкість дуже різна в різних людей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这种转变是渐进的，而不是一个开关，而且快慢因人而异，差别很大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這種轉變是漸進的，而不是一個開關，而且快慢因人而異，差別很大。"
          }
        }
      }
    },
    "phase.fat.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glycogen runs low and the body turns more towards fat for fuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Glykogen wird knapp, und der Körper nutzt stärker Fett als Brennstoff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le glycogène s’épuise et le corps se tourne davantage vers les graisses."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El glucógeno se agota y el cuerpo recurre más a la grasa como combustible."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El glucógeno se agota y el cuerpo recurre más a la grasa como combustible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O glicogênio acaba e o corpo passa a usar mais gordura como combustível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il glicogeno si esaurisce e il corpo ricorre di più ai grassi come carburante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het glycogeen raakt op en het lichaam gebruikt meer vet als brandstof."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glikogenu ubywa, a organizm sięga częściej po tłuszcz jako paliwo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリコーゲンが少なくなり、体は脂肪を燃料として使いはじめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글리코겐이 줄고 몸이 지방을 연료로 더 많이 쓰기 시작합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гликогена становится меньше, и организм всё больше переходит на жир как топливо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Глікогену стає менше, і організм дедалі більше переходить на жир як паливо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "糖原变少，身体更多地转向脂肪作为燃料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "肝醣變少，身體更多地轉向脂肪作為燃料。"
          }
        }
      }
    },
