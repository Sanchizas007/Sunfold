    "onboarding.protocol.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure? 16:8 is where most people start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicher? Mit 16:8 fangen die meisten an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous hésitez ? La plupart des gens commencent par 16:8."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No sabes cuál? La mayoría empieza con 16:8."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo tienes claro? La mayoría empieza con 16:8."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dúvida? A maioria começa com 16:8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai dei dubbi? La maggior parte inizia con il 16:8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet zeker? De meeste mensen beginnen met 16:8."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wiesz, co wybrać? Większość zaczyna od 16:8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷ったら16:8から。多くの人がここから始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고민된다면 16:8부터. 대부분 여기서 시작합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не уверены? Большинство начинает с 16:8."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не впевнені? Більшість починає з 16:8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拿不定主意？大多数人从 16:8 开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拿不定主意？大多數人從 16:8 開始。"
          }
        }
      }
    },
    "onboarding.protocol.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this at any time, even mid-fast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das jederzeit ändern, auch mitten im Fasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer à tout moment, même en plein jeûne."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo cuando quieras, incluso a mitad del ayuno."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo cuando quieras, incluso a mitad del ayuno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar a qualquer momento, até no meio do jejum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiarlo quando vuoi, anche a digiuno iniziato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit altijd wijzigen, ook midden in een vastenperiode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to zmienić w dowolnej chwili, nawet w trakcie postu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも変更できます。ファスティングの途中でも大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 바꿀 수 있습니다. 단식 중에도 가능합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это можно изменить в любой момент, даже посреди голодания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це можна змінити будь-коли, навіть посеред голодування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你随时可以更改，哪怕断食已经开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以更改，就算斷食已經開始也沒問題。"
          }
        }
      }
    },
